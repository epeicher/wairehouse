+/**
+ * Calculator — window styles.
+ *
+ * Layout only: the readout on top, a 4-column keypad that grows with
+ * the window so the caps stay large. The caps and the readout paint
+ * themselves through their own tokens; this sheet declares no colour
+ * beyond the muted text token every app reads.
+ */
+
+.os-calc {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	block-size: 100%;
+	padding: 12px;
+	box-sizing: border-box;
+}
+
+.os-calc__screen {
+	flex: none;
+	display: flex;
+	flex-direction: column;
+	align-items: flex-end;
+	gap: 2px;
+	min-inline-size: 0;
+}
+
+/* The pending left operand and operator, e.g. "12 ×". Always holds
+   its line so the readout does not jump when it appears. */
+.os-calc__expression {
+	min-block-size: 1.4em;
+	font-size: 14px;
+	font-variant-numeric: tabular-nums;
+	color: var( --os-ui-fg-muted, #646970 );
+}
+
+.os-calc__display {
+	align-self: stretch;
+}
+
+.os-calc__keys {
+	flex: 1;
+	display: grid;
+	grid-template-columns: repeat( 4, 1fr );
+	grid-auto-rows: 1fr;
+	gap: 8px;
+	min-block-size: 0;
+	--os-ui-key-min-height: 44px;
+	--os-ui-key-font-size: 22px;
+}
+
+.os-calc__key--wide {
+	grid-column: span 2;
+}
