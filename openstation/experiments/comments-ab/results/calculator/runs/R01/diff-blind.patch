+<?php
+/**
+ * Calculator — a four-function calculator, as an OpenStation app.
+ *
+ * This file is the window: title, icon, size, the dock tile and the
+ * desktop shortcut, and the state schema. There is no server action
+ * and no `data()`: every key press is a `local` reducer in
+ * `calculator.os.ts`, so arithmetic never waits for a request.
+ *
+ * @package OpenStation
+ */
+
+namespace OpenStation\Apps\Calculator;
+
+use OpenStation\App;
+
+// Direct access, unless a standalone host is booting on bare PHP.
+if ( ! defined( 'ABSPATH' ) ) {
+	defined( 'OPENSTATION_STANDALONE' ) || exit;
+}
+
+/** A calculator body: the readout across the top, a 3×2 keypad below. */
+const ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="12" y="6" width="40" height="52" rx="7" fill="none" stroke="currentColor" stroke-width="4.5"/><rect x="20" y="14" width="24" height="10" rx="2" fill="currentColor"/><circle cx="24" cy="34" r="3.5" fill="currentColor"/><circle cx="40" cy="34" r="3.5" fill="currentColor"/><circle cx="24" cy="47" r="3.5" fill="currentColor"/><circle cx="40" cy="47" r="3.5" fill="currentColor"/></svg>';
+
+return App::define( 'openstation-calculator' )
+	->title( __( 'Calculator', 'desktop-mode' ) )
+	->icon( ICON )
+	->size( 320, 480 )
+	->min_size( 260, 380 )
+	->desktop_icon()
+	// Nothing here reads or writes the site, so any user with a shell
+	// may use it.
+	->capabilities( 'read' )
+	// The body takes focus on open, so typed digits land here — and
+	// only here: the keyboard handler listens on the window body,
+	// never on the document.
+	->autofocus()
+	->state(
+		array(
+			// What the readout shows: the entry being typed, or a result.
+			'display' => '0',
+			// The left operand, waiting for its operator's right one.
+			'stored'  => '',
+			// The pending operator: `+`, `-`, `*`, `/`, or '' for none.
+			'op'      => '',
+			// The next digit starts a new entry instead of extending it.
+			'fresh'   => false,
+			// The last result was not a number (division by zero).
+			'error'   => false,
+		)
+	);
