+++ w/apps/calculator/calculator.test.ts
@@ -0,0 +1,99 @@
+/**
+ * Calculator — the reducer, the key map, and the view's wiring.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import '../../src/ui/components/os-key/os-key';
+import '../../src/ui/components/os-display/os-display';
+import { mockViewContext } from '../../src/app-runtime/testing';
+import app, { INITIAL, keyInput, press, type Input, type State } from './calculator.os';
+
+/** The state after pressing each input in turn from a cleared calculator. */
+const run = ( ...inputs: Input[] ): State => inputs.reduce( press, { ...INITIAL } );
+
+describe( 'press', () => {
+	it( 'does the arithmetic a pocket calculator does', () => {
+		expect( run( '1', '2', '+', '3', '=' ).display ).toBe( '15' );
+		// Chaining settles left to right, and shows the running total.
+		const chained = run( '2', '+', '3', '*' );
+		expect( [ chained.display, chained.stored, chained.op ] ).toEqual( [ '5', '5', '*' ] );
+		expect( run( '2', '+', '3', '*', '4', '=' ).display ).toBe( '20' );
+		// A second operator replaces the first; `=` with no right operand reuses the left.
+		expect( run( '9', '+', '-', '4', '=' ).display ).toBe( '5' );
+		expect( run( '5', '+', '=' ).display ).toBe( '10' );
+		// The double's tail never reaches the readout.
+		expect( run( '.', '1', '+', '.', '2', '=' ).display ).toBe( '0.3' );
+		// A digit after a result starts a new entry.
+		expect( run( '2', '*', '3', '=', '7' ).display ).toBe( '7' );
+	} );
+
+	it( 'reports division by zero and recovers on the next key', () => {
+		const broken = run( '8', '/', '0', '=' );
+		expect( broken.error ).toBe( true );
+		expect( press( broken, '+' ) ).toEqual( INITIAL );
+		expect( press( broken, '4' ) ).toMatchObject( { display: '4', error: false } );
+	} );
+
+	it( 'edits the entry: zeros, one point, a digit cap, backspace and sign', () => {
+		expect( run( '0', '0', '7' ).display ).toBe( '7' );
+		expect( run( '1', '.', '.', '5' ).display ).toBe( '1.5' );
+		expect( run( ...( Array( 20 ).fill( '9' ) as Input[] ) ).display ).toHaveLength( 15 );
+		expect( run( '4', '2', 'back' ).display ).toBe( '4' );
+		expect( run( '4', 'sign', 'back' ).display ).toBe( '0' );
+		expect( run( 'sign', '3' ).display ).toBe( '-3' );
+		expect( run( '6', 'sign', '+', '2', '=' ).display ).toBe( '-4' );
+		expect( run( '6', '+', '2', 'clear' ) ).toEqual( INITIAL );
+	} );
+} );
+
+describe( 'keyInput', () => {
+	const key = ( k: string, mods: Partial< KeyboardEvent > = {} ) =>
+		keyInput( { key: k, ctrlKey: false, altKey: false, metaKey: false, ...mods } );
+
+	it( 'maps the keys a numpad and a keyboard type, and no shortcut', () => {
+		expect( [ '7', '*', ',', 'Enter', '=', 'Backspace', 'Escape' ].map( ( k ) => key( k ) ) )
+			.toEqual( [ '7', '*', '.', '=', '=', 'back', 'clear' ] );
+		expect( key( 'a' ) ).toBeNull();
+		expect( key( 'c', { metaKey: true } ) ).toBeNull();
+		expect( key( '7', { ctrlKey: true } ) ).toBeNull();
+	} );
+} );
+
+describe( 'view', () => {
+	it( 'presses through the caps and the window keyboard, never the document', () => {
+		const body = document.createElement( 'div' );
+		body.className = 'os-window__body';
+		const root = document.createElement( 'div' );
+		body.appendChild( root );
+		document.body.appendChild( body );
+		const local = vi.fn();
+		const ctx = mockViewContext< State, Record< string, never > >( { state: { ...INITIAL, op: '*', stored: '12' }, data: {}, root, local } );
+		app.render( ctx );
+		const teardown = app.mounted( ctx );
+
+		expect( root.querySelector( 'os-display' )?.getAttribute( 'value' ) ).toBe( '0' );
+		expect( root.querySelector( '.os-calc__expression' )?.textContent ).toBe( '12 ×' );
+		// The caps must not match keys document-wide (see the file header).
+		expect( root.querySelector( 'os-key[key], os-key[code]' ) ).toBeNull();
+
+		root.querySelector( 'os-key[data-input="7"]' )!.dispatchEvent( new CustomEvent( 'os-key', { bubbles: true } ) );
+		expect( local ).toHaveBeenLastCalledWith( 'press', { input: '7' } );
+
+		// A key typed in another window does nothing here…
+		local.mockClear();
+		document.body.dispatchEvent( new KeyboardEvent( 'keydown', { key: '5', bubbles: true } ) );
+		expect( local ).not.toHaveBeenCalled();
+
+		// …one typed with focus in this window presses, and Enter does not also click the focused cap.
+		const enter = new KeyboardEvent( 'keydown', { key: 'Enter', bubbles: true, cancelable: true } );
+		root.querySelector( 'os-key' )!.dispatchEvent( enter );
+		expect( local ).toHaveBeenLastCalledWith( 'press', { input: '=' } );
+		expect( enter.defaultPrevented ).toBe( true );
+
+		if ( typeof teardown === 'function' ) {
+			teardown();
+		}
+		body.dispatchEvent( new KeyboardEvent( 'keydown', { key: '1', bubbles: true } ) );
+		expect( local ).toHaveBeenCalledTimes( 1 );
+		body.remove();
+	} );
+} );
