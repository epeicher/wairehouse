+/**
+ * Calculator — the model through key sequences, the keyboard map,
+ * and one render of the view into jsdom.
+ */
+import { describe, expect, it } from 'vitest';
+import { mockViewContext } from '../../src/app-runtime/testing';
+import app, { initialState, press, tokenForKey, type CalcState } from './calculator.os';
+
+/** The state after pressing each token in turn, from a cleared calculator. */
+function run( ...tokens: string[] ): CalcState {
+	return tokens.reduce( press, initialState() );
+}
+
+describe( 'model', () => {
+	it( 'chains operations left to right and keeps float noise out of the readout', () => {
+		expect( run( '1', '2', '+', '3', '*', '2', '=' ).display ).toBe( '30' );
+		expect( run( '.', '1', '+', '0', '.', '2', '=' ).display ).toBe( '0.3' );
+		// Changing your mind about the operator replaces it.
+		expect( run( '9', '+', '-', '4', '=' ).display ).toBe( '5' );
+		// A result is replaced, not extended, by the next digit.
+		expect( run( '2', '+', '2', '=', '7' ).display ).toBe( '7' );
+	} );
+
+	it( 'edits the entry: backspace, sign, decimal point, percent', () => {
+		expect( run( '1', '2', '3', 'back' ).display ).toBe( '12' );
+		expect( run( '5', 'back' ).display ).toBe( '0' );
+		expect( run( '5', 'negate', 'back' ).display ).toBe( '0' );
+		expect( run( '5', 'negate', '3' ).display ).toBe( '-53' );
+		expect( run( '1', '.', '.', '5' ).display ).toBe( '1.5' );
+		expect( run( '5', '0', 'percent' ).display ).toBe( '0.5' );
+	} );
+
+	it( 'reports division by zero and recovers on the next number', () => {
+		const failed = run( '8', '/', '0', '=' );
+		expect( failed.error ).toBe( true );
+		expect( press( failed, '+' ) ).toBe( failed );
+		expect( press( failed, '4' ) ).toMatchObject( { display: '4', error: false } );
+	} );
+} );
+
+describe( 'keyboard', () => {
+	const key = ( k: string, mods: Partial< KeyboardEvent > = {} ) =>
+		tokenForKey( { key: k, ctrlKey: false, metaKey: false, altKey: false, ...mods } );
+
+	it( 'maps calculator keys and leaves chords and other keys alone', () => {
+		expect( [ key( '7' ), key( '*' ), key( 'Enter' ), key( ',' ), key( 'Escape' ) ] ).toEqual( [ '7', '*', '=', '.', 'clear' ] );
+		expect( key( '-', { metaKey: true } ) ).toBeNull();
+		expect( key( 'a' ) ).toBeNull();
+	} );
+} );
+
+describe( 'view', () => {
+	it( 'renders a 20-key keypad wired to the local press action, marking the pending operator', () => {
+		const root = document.createElement( 'div' );
+		const state = run( '1', '2', '*' );
+		app.render( mockViewContext( { state, data: null, root } ) );
+
+		const keys = Array.from( root.querySelectorAll( 'os-button' ) );
+		expect( keys ).toHaveLength( 20 );
+		expect( keys.every( ( k ) => k.getAttribute( 'os-action' ) === 'press' ) ).toBe( true );
+		expect( keys.every( ( k ) => k.getAttribute( 'aria-label' ) ) ).toBe( true );
+		expect( app.hasLocal( 'press' ) ).toBe( true );
+
+		const pending = keys.filter( ( k ) => k.hasAttribute( 'data-pending' ) );
+		expect( pending.map( ( k ) => k.getAttribute( 'os-arg-token' ) ) ).toEqual( [ '*' ] );
+		expect( root.querySelector( '.os-calculator__expression' )?.textContent ).toBe( '12 ×' );
+		expect( root.querySelector( 'os-display' )?.getAttribute( 'value' ) ).toBe( '12' );
+	} );
+} );
