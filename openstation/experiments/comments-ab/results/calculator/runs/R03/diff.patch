+<?php
+/**
+ * Calculator — a basic four-function calculator, as an OpenStation app.
+ *
+ * This file is the window: title, icon, size, the dock tile, the
+ * desktop shortcut and the state schema. There is no server action
+ * and no `data()`: every key press is a `local` reducer in
+ * `calculator.os.ts`, so arithmetic never waits for a request. The
+ * state is declared here anyway because the runtime only accepts
+ * writes to declared keys.
+ *
+ * @package OpenStation
+ */
+
+namespace OpenStation\Apps\Calculator;
+
+use OpenStation\App;
+
+// Direct access, unless a standalone host is booting on bare PHP.
+if ( ! defined( 'ABSPATH' ) ) {
+	defined( 'OPENSTATION_STANDALONE' ) || exit;
+}
+
+/** A calculator body: the readout band and a 3×2 grid of keys. */
+const ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="12" y="6" width="40" height="52" rx="6" fill="none" stroke="currentColor" stroke-width="4"/><rect x="19" y="13" width="26" height="10" rx="2" fill="currentColor"/><g fill="currentColor"><circle cx="22" cy="33" r="3"/><circle cx="32" cy="33" r="3"/><circle cx="42" cy="33" r="3"/><circle cx="22" cy="45" r="3"/><circle cx="32" cy="45" r="3"/><circle cx="42" cy="45" r="3"/></g></svg>';
+
+return App::define( 'openstation-calculator' )
+	->title( __( 'Calculator', 'desktop-mode' ) )
+	->icon( ICON )
+	->size( 340, 500 )
+	->min_size( 280, 420 )
+	// The default `dock` placement proposes the dock tile. The
+	// shortcut merges into that same launcher (one nav item per app,
+	// see `src/nav/defaults.ts`), so it does not propose a second
+	// default: it is what the wallpaper shows, at this slot, once the
+	// user adds the launcher there from the tile's context menu or
+	// Preferences → Navigation.
+	->desktop_icon( array( 'position' => 26 ) )
+	->capabilities( 'read' )
+	->state(
+		array(
+			'display' => '0',
+			'stored'  => '',
+			'op'      => '',
+			'fresh'   => true,
+			'error'   => false,
+		)
+	);
