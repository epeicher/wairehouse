+/*
+ * Calculator — the readout on top, the keypad filling the rest.
+ *
+ * Loaded by the App Framework as the app's stylesheet on the window's
+ * first open. Sizes only: every colour comes from the kit's own tokens,
+ * so the palette and desktop themes reach the keys unchanged.
+ */
+
+.os-calculator {
+	box-sizing: border-box;
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	block-size: 100%;
+	padding: 12px;
+}
+
+/* The container takes focus only so typed keys reach it; the keys draw their own rings. */
+.os-calculator:focus {
+	outline: none;
+}
+
+.os-calculator__screen {
+	display: flex;
+	flex-direction: column;
+	align-items: flex-end;
+	gap: 4px;
+	min-inline-size: 0;
+}
+
+.os-calculator__expression {
+	min-block-size: 1.4em;
+	font-variant-numeric: tabular-nums;
+	color: var( --os-ui-fg-muted, #646970 );
+}
+
+.os-calculator__keys {
+	flex: 1;
+	min-block-size: 0;
+}
+
+/* Large keys: the grid's rows set the height, the label scales with it. */
+.os-calculator__keys os-button {
+	--os-ui-button-min-height: 48px;
+	font-size: 22px;
+}
+
+/*
+ * The operator waiting for its second operand reads as pressed — a
+ * stronger edge, not the accent, which the dock spends on the front
+ * window.
+ */
+.os-calculator__keys os-button[data-pending] {
+	--os-ui-button-border: 2px solid var( --os-ui-fg, #1d2327 );
+}
