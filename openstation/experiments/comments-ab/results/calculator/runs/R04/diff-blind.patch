+.os-calc {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	block-size: 100%;
+	padding: 12px;
+	box-sizing: border-box;
+}
+
+.os-calc:focus {
+	outline: none;
+}
+
+.os-calc__screen {
+	display: flex;
+	flex-direction: column;
+	min-inline-size: 0;
+}
+
+.os-calc__expression {
+	min-block-size: 1.4em;
+	padding-inline: 14px;
+	text-align: end;
+	color: var( --os-ui-fg-muted, #646970 );
+	font-variant-numeric: tabular-nums;
+	overflow: hidden;
+	white-space: nowrap;
+	text-overflow: ellipsis;
+}
+
+.os-calc__keys {
+	flex: 1;
+	display: grid;
+	grid-template-columns: repeat( 4, minmax( 0, 1fr ) );
+	grid-auto-rows: minmax( 48px, 1fr );
+	gap: 8px;
+}
+
+.os-calc__key {
+	--os-ui-button-min-height: 48px;
+	font-size: 1.375rem;
+	font-variant-numeric: tabular-nums;
+}
+
+.os-calc__key--wide {
+	grid-column: span 2;
+}
+
+.os-calc__key--pending {
+	--os-ui-button-border: 2px solid var( --os-ui-fg, #1d2327 );
+}
