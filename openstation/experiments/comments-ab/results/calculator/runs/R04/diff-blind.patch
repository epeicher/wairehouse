@@ -0,0 +1,61 @@
+import { describe, expect, it, vi } from 'vitest';
+import { mockViewContext } from '../../src/app-runtime/testing';
+import app, { type CalcState } from './calculator.os';
+
+const INITIAL: CalcState = { display: '0', stored: '', operator: '', fresh: false, error: false };
+
+function press( ...keys: string[] ): CalcState {
+	let state: Record< string, unknown > = { ...INITIAL };
+	for ( const key of keys ) {
+		const [ action, value ] = key.split( ':' );
+		state = app.runLocal( action, state, value === undefined ? {} : { value }, {} );
+	}
+	return state as CalcState;
+}
+
+describe( 'calculator', () => {
+	it( 'chains operators left to right and rounds away float noise', () => {
+		expect( press( 'digit:2', 'operator:+', 'digit:3', 'operator:*', 'digit:4', 'equals' ).display ).toBe( '20' );
+		expect( press( 'digit:0', 'decimal', 'digit:1', 'operator:+', 'digit:0', 'decimal', 'digit:2', 'equals' ).display ).toBe( '0.3' );
+	} );
+
+	it( 'replaces a pending operator and repeats the left operand on a bare equals', () => {
+		expect( press( 'digit:5', 'operator:+', 'operator:-', 'digit:2', 'equals' ).display ).toBe( '3' );
+		expect( press( 'digit:5', 'operator:+', 'equals' ).display ).toBe( '10' );
+	} );
+
+	it( 'starts a new entry after a result and edits only the entry', () => {
+		expect( press( 'digit:1', 'operator:+', 'digit:1', 'equals', 'digit:7' ).display ).toBe( '7' );
+		expect( press( 'digit:1', 'digit:2', 'backspace', 'backspace' ).display ).toBe( '0' );
+		expect( press( 'digit:1', 'decimal', 'decimal', 'digit:5', 'negate' ).display ).toBe( '-1.5' );
+		expect( press( 'digit:5', 'digit:0', 'percent' ).display ).toBe( '0.5' );
+	} );
+
+	it( 'shows an error on division by zero and recovers on the next digit', () => {
+		const failed = press( 'digit:8', 'operator:/', 'digit:0', 'equals' );
+		expect( failed.error ).toBe( true );
+		expect( press( 'digit:8', 'operator:/', 'digit:0', 'equals', 'digit:4' ) ).toEqual( { ...INITIAL, display: '4' } );
+	} );
+
+	it( 'maps the keyboard onto the keypad without swallowing shortcuts', () => {
+		const root = document.createElement( 'div' );
+		const local = vi.fn();
+		const ctx = mockViewContext< CalcState, Record< string, never > >( { state: INITIAL, data: {}, root, local } );
+		const teardown = app.mounted( ctx as never );
+
+		const key = ( init: KeyboardEventInit ) => {
+			const ev = new KeyboardEvent( 'keydown', { bubbles: true, cancelable: true, ...init } );
+			root.dispatchEvent( ev );
+			return ev.defaultPrevented;
+		};
+		expect( key( { key: '7' } ) ).toBe( true );
+		expect( key( { key: 'Enter' } ) ).toBe( true );
+		expect( key( { key: '-', metaKey: true } ) ).toBe( false );
+		expect( key( { key: 'a' } ) ).toBe( false );
+		expect( local.mock.calls ).toEqual( [ [ 'digit', { value: '7' } ], [ 'equals', undefined ] ] );
+
+		if ( typeof teardown === 'function' ) {
+			teardown();
+		}
+	} );
+} );
