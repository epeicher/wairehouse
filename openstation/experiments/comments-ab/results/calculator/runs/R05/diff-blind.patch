@@ -0,0 +1,47 @@
+.os-calc {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	block-size: 100%;
+	padding: 12px;
+	box-sizing: border-box;
+	outline: none;
+}
+
+.os-calc__screen {
+	display: flex;
+	flex-direction: column;
+	align-items: flex-end;
+	flex: none;
+	padding: 8px 0;
+	border-block-end: 1px solid var( --os-ui-border, #c3c4c7 );
+}
+
+.os-calc__pending {
+	min-block-size: 1.4em;
+	padding-inline: 14px;
+	font-size: 14px;
+	font-variant-numeric: tabular-nums;
+	color: var( --os-ui-fg-muted, #50575e );
+}
+
+.os-calc__keys {
+	display: grid;
+	flex: 1;
+	grid-template-columns: repeat( 4, minmax( 0, 1fr ) );
+	grid-template-rows: repeat( 5, minmax( 0, 1fr ) );
+	gap: 8px;
+	min-block-size: 0;
+}
+
+.os-calc__key {
+	--os-ui-button-min-height: 48px;
+	--os-ui-button-border-radius: 10px;
+	--os-ui-button-padding: 0;
+	font-size: 22px;
+	font-variant-numeric: tabular-nums;
+}
+
+.os-calc__key--operator[aria-pressed="true"] {
+	--os-ui-button-border: 2px solid var( --os-ui-border-strong, #8c8f94 );
+}
