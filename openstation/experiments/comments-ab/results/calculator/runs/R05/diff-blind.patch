+<?php
+
+namespace OpenStation\Apps\Calculator;
+
+use OpenStation\App;
+
+if ( ! defined( 'ABSPATH' ) ) {
+	defined( 'OPENSTATION_STANDALONE' ) || exit;
+}
+
+const ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="12" y="4" width="40" height="56" rx="7" fill="none" stroke="currentColor" stroke-width="4"/><rect x="19" y="12" width="26" height="11" rx="2" fill="currentColor"/><circle cx="22" cy="33" r="3.5" fill="currentColor"/><circle cx="32" cy="33" r="3.5" fill="currentColor"/><circle cx="42" cy="33" r="3.5" fill="currentColor"/><circle cx="22" cy="43" r="3.5" fill="currentColor"/><circle cx="32" cy="43" r="3.5" fill="currentColor"/><circle cx="42" cy="43" r="3.5" fill="currentColor"/><circle cx="22" cy="52" r="3.5" fill="currentColor"/><circle cx="32" cy="52" r="3.5" fill="currentColor"/><circle cx="42" cy="52" r="3.5" fill="currentColor"/></svg>';
+
+return App::define( 'openstation-calculator' )
+	->title( __( 'Calculator', 'desktop-mode' ) )
+	->icon( ICON )
+	->size( 320, 480 )
+	->min_size( 260, 380 )
+	->autofocus( '.os-calc' )
+	->desktop_icon()
+	->capabilities( 'read' )
+	->state(
+		array(
+			'display'     => '0',
+			'accumulator' => '',
+			'operator'    => '',
+			'overwrite'   => false,
+			'error'       => false,
+		)
+	);
diff --git c/apps/calculator/calculator.os.ts w/apps/calculator/calculator.os.ts
new file mode 100644
index 00000000..b790d051
--- /dev/null
+++ w/apps/calculator/calculator.os.ts
@@ -0,0 +1,230 @@
+import { __, defineApp, html } from '@openstation/app';
+
+export type Operator = '' | '+' | '-' | '*' | '/';
+
+export interface CalcState extends Record< string, unknown > {
+	display: string;
+	accumulator: string;
+	operator: Operator;
+	overwrite: boolean;
+	error: boolean;
+}
+
+type Data = Record< string, never >;
+
+interface Key {
+	key: string;
+	label: string;
+	name?: string;
+	kind: 'digit' | 'function' | 'operator' | 'equals';
+}
+
+const MAX_DIGITS = 15;
+
+export const INITIAL: CalcState = { display: '0', accumulator: '', operator: '', overwrite: false, error: false };
+
+const OPERATORS: readonly string[] = [ '+', '-', '*', '/' ];
+
+const SYMBOLS: Record< string, string > = { '+': '+', '-': '−', '*': '×', '/': '÷' };
+
+const KEYS = (): Key[] => [
+	{ key: 'clear', label: 'AC', name: __( 'All clear' ), kind: 'function' },
+	{ key: 'negate', label: '±', name: __( 'Change sign' ), kind: 'function' },
+	{ key: '%', label: '%', name: __( 'Percent' ), kind: 'function' },
+	{ key: '/', label: '÷', name: __( 'Divide' ), kind: 'operator' },
+	{ key: '7', label: '7', kind: 'digit' },
+	{ key: '8', label: '8', kind: 'digit' },
+	{ key: '9', label: '9', kind: 'digit' },
+	{ key: '*', label: '×', name: __( 'Multiply' ), kind: 'operator' },
+	{ key: '4', label: '4', kind: 'digit' },
+	{ key: '5', label: '5', kind: 'digit' },
+	{ key: '6', label: '6', kind: 'digit' },
+	{ key: '-', label: '−', name: __( 'Subtract' ), kind: 'operator' },
+	{ key: '1', label: '1', kind: 'digit' },
+	{ key: '2', label: '2', kind: 'digit' },
+	{ key: '3', label: '3', kind: 'digit' },
+	{ key: '+', label: '+', name: __( 'Add' ), kind: 'operator' },
+	{ key: 'back', label: '⌫', name: __( 'Backspace' ), kind: 'function' },
+	{ key: '0', label: '0', kind: 'digit' },
+	{ key: '.', label: '.', name: __( 'Decimal point' ), kind: 'digit' },
+	{ key: '=', label: '=', name: __( 'Equals' ), kind: 'equals' },
+];
+
+const KEYBOARD: Record< string, string > = {
+	Enter: '=',
+	'=': '=',
+	',': '.',
+	x: '*',
+	X: '*',
+	Backspace: 'back',
+	Escape: 'clear',
+	Delete: 'clear',
+};
+
+export function formatNumber( value: number ): string {
+	return String( parseFloat( value.toPrecision( 12 ) ) );
+}
+
+export function compute( a: number, operator: Operator, b: number ): number {
+	switch ( operator ) {
+		case '+':
+			return a + b;
+		case '-':
+			return a - b;
+		case '*':
+			return a * b;
+		case '/':
+			return a / b;
+		default:
+			return b;
+	}
+}
+
+function settle( state: CalcState, value: number ): CalcState {
+	if ( ! Number.isFinite( value ) ) {
+		return { ...INITIAL, error: true, overwrite: true };
+	}
+	return { ...state, display: String( value ), overwrite: true };
+}
+
+export function readout( state: CalcState ): string {
+	if ( state.error ) {
+		return __( 'Error' );
+	}
+	const shown = state.overwrite ? formatNumber( Number( state.display ) ) : state.display;
+	return shown.replace( '-', '−' );
+}
+
+export function press( state: CalcState, key: string ): CalcState {
+	if ( key === 'clear' ) {
+		return { ...INITIAL };
+	}
+	if ( state.error ) {
+		if ( /^[0-9.]$/.test( key ) ) {
+			return press( { ...INITIAL }, key );
+		}
+		return key === 'back' ? { ...INITIAL } : state;
+	}
+
+	if ( /^[0-9]$/.test( key ) ) {
+		if ( state.overwrite || state.display === '0' ) {
+			return { ...state, display: key, overwrite: false };
+		}
+		if ( state.display.replace( /[^0-9]/g, '' ).length >= MAX_DIGITS ) {
+			return state;
+		}
+		return { ...state, display: state.display + key };
+	}
+
+	if ( key === '.' ) {
+		if ( state.overwrite ) {
+			return { ...state, display: '0.', overwrite: false };
+		}
+		return state.display.includes( '.' ) ? state : { ...state, display: `${ state.display }.` };
+	}
+
+	if ( OPERATORS.includes( key ) ) {
+		const operator = key as Operator;
+		if ( state.operator !== '' && state.accumulator !== '' && ! state.overwrite ) {
+			const next = settle( state, compute( Number( state.accumulator ), state.operator, Number( state.display ) ) );
+			return next.error ? next : { ...next, accumulator: next.display, operator };
+		}
+		return { ...state, accumulator: state.display, operator, overwrite: true };
+	}
+
+	if ( key === '=' ) {
+		if ( state.operator === '' || state.accumulator === '' ) {
+			return state;
+		}
+		const next = settle( state, compute( Number( state.accumulator ), state.operator, Number( state.display ) ) );
+		return { ...next, accumulator: '', operator: '' };
+	}
+
+	if ( key === 'negate' ) {
+		if ( state.display === '0' ) {
+			return state;
+		}
+		const display = state.display.startsWith( '-' ) ? state.display.slice( 1 ) : `-${ state.display }`;
+		return { ...state, display };
+	}
+
+	if ( key === '%' ) {
+		return settle( state, Number( state.display ) / 100 );
+	}
+
+	if ( key === 'back' ) {
+		if ( state.overwrite ) {
+			return state;
+		}
+		const display = state.display.slice( 0, -1 );
+		return { ...state, display: display === '' || display === '-' ? '0' : display };
+	}
+
+	return state;
+}
+
+export function keyFor( ev: KeyboardEvent ): string | null {
+	if ( ev.ctrlKey || ev.metaKey || ev.altKey ) {
+		return null;
+	}
+	const mapped = KEYBOARD[ ev.key ] ?? ev.key;
+	return /^[0-9.%]$/.test( mapped ) || OPERATORS.includes( mapped ) || [ '=', 'back', 'clear' ].includes( mapped )
+		? mapped
+		: null;
+}
+
+function pending( state: CalcState ): string {
+	if ( state.error || state.operator === '' || state.accumulator === '' ) {
+		return '';
+	}
+	return `${ formatNumber( Number( state.accumulator ) ).replace( '-', '−' ) } ${ SYMBOLS[ state.operator ] }`;
+}
+
+function variant( key: Key ): string {
+	if ( key.kind === 'equals' ) {
+		return 'primary';
+	}
+	return key.kind === 'function' ? 'ghost' : 'secondary';
+}
+
+export default defineApp< CalcState, Data >( 'openstation-calculator', {
+	local: {
+		key: ( state, args ) => press( state, String( args.key ?? '' ) ),
+	},
+
+	placeholder: () => ( {} ),
+
+	view: ( { state } ) => html`<div class="os-calc" tabindex="-1">
+		<div class="os-calc__screen">
+			<div class="os-calc__pending" aria-hidden="true">${ pending( state ) }</div>
+			<os-display size="xl" value=${ readout( state ) }></os-display>
+		</div>
+		<div class="os-calc__keys">
+			${ KEYS().map( ( key ) => html`<os-button
+				fill-cell
+				class=${ `os-calc__key os-calc__key--${ key.kind }` }
+				variant=${ variant( key ) }
+				aria-label=${ key.name ?? key.label }
+				aria-pressed=${ key.kind === 'operator' ? String( state.overwrite && state.operator === key.key && ! state.error ) : null }
+				os-action="key"
+				os-arg-key=${ key.key }
+			>${ key.label }</os-button>` ) }
+		</div>
+	</div>`,
+
+	mounted: ( ctx ) => {
+		const onKey = ( ev: KeyboardEvent ): void => {
+			const key = keyFor( ev );
+			if ( key === null ) {
+				return;
+			}
+			if ( ev.key === 'Enter' && ( ev.target as Element | null )?.closest?.( 'os-button' ) ) {
+				return;
+			}
+			ev.preventDefault();
+			ctx.local( 'key', { key } );
+		};
+		ctx.root.addEventListener( 'keydown', onKey );
+		return () => ctx.root.removeEventListener( 'keydown', onKey );
+	},
+} );
diff --git c/apps/calculator/calculator.test.ts w/apps/calculator/calculator.test.ts
