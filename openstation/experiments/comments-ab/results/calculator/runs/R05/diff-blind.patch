@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+import { mockViewContext } from '../../src/app-runtime/testing';
+import app, { INITIAL, keyFor, press, readout, type CalcState } from './calculator.os';
+
+function run( keys: string[], from: CalcState = INITIAL ): CalcState {
+	return keys.reduce( press, { ...from } );
+}
+
+const shown = ( keys: string[] ): string => readout( run( keys ) );
+
+describe( 'press', () => {
+	it( 'chains operators left to right and starts fresh after equals', () => {
+		expect( shown( [ '1', '2', '+', '3', '*', '2', '=' ] ) ).toBe( '30' );
+		expect( shown( [ '9', '-', '-', '+', '1', '=' ] ) ).toBe( '10' );
+		expect( run( [ '2', '+', '2', '=', '7' ] ) ).toMatchObject( { display: '7', accumulator: '', operator: '' } );
+	} );
+
+	it( 'rounds what it shows but keeps full precision for the next step', () => {
+		expect( shown( [ '.', '1', '+', '.', '2', '=' ] ) ).toBe( '0.3' );
+		expect( shown( [ '1', '/', '3', '=' ] ) ).toBe( '0.333333333333' );
+		expect( shown( [ '1', '/', '3', '=', '*', '3', '=' ] ) ).toBe( '1' );
+		expect( shown( [ '5', '-', '8', '=' ] ) ).toBe( '−3' );
+	} );
+
+	it( 'reports division by zero and recovers on the next entry', () => {
+		const error = run( [ '5', '/', '0', '=' ] );
+		expect( readout( error ) ).toBe( 'Error' );
+		expect( press( error, '+' ) ).toBe( error );
+		expect( press( error, '4' ) ).toMatchObject( { display: '4', error: false } );
+	} );
+
+	it( 'edits the entry with backspace, sign, decimal point and percent', () => {
+		expect( shown( [ '1', '2', '3', 'back' ] ) ).toBe( '12' );
+		expect( shown( [ '7', 'negate', 'back' ] ) ).toBe( '0' );
+		expect( shown( [ '4', '+', '4', '=', 'back' ] ) ).toBe( '8' );
+		expect( shown( [ '1', '.', '.', '5' ] ) ).toBe( '1.5' );
+		expect( shown( [ '5', '0', '%' ] ) ).toBe( '0.5' );
+		expect( shown( Array( 20 ).fill( '9' ) ) ).toHaveLength( 15 );
+	} );
+} );
+
+describe( 'keyboard', () => {
+	it( 'maps keys to calculator keys and leaves shortcuts alone', () => {
+		const ev = ( key: string, init: KeyboardEventInit = {} ) => new KeyboardEvent( 'keydown', { key, ...init } );
+		expect( keyFor( ev( '7' ) ) ).toBe( '7' );
+		expect( keyFor( ev( 'Enter' ) ) ).toBe( '=' );
+		expect( keyFor( ev( ',' ) ) ).toBe( '.' );
+		expect( keyFor( ev( 'Escape' ) ) ).toBe( 'clear' );
+		expect( keyFor( ev( 'c', { metaKey: true } ) ) ).toBeNull();
+		expect( keyFor( ev( 'a' ) ) ).toBeNull();
+	} );
+} );
+
+describe( 'view', () => {
+	it( 'shows the pending operation and marks only the armed operator', () => {
+		const root = document.createElement( 'div' );
+		app.render( mockViewContext( { state: run( [ '1', '2', '*' ] ), data: {}, root } ) );
+		expect( root.querySelector( '.os-calc__pending' )?.textContent ).toBe( '12 ×' );
+		const pressed = Array.from( root.querySelectorAll( '[aria-pressed="true"]' ) );
+		expect( pressed.map( ( el ) => el.getAttribute( 'os-arg-key' ) ) ).toEqual( [ '*' ] );
+		expect( root.querySelector( '[os-arg-key="7"]' )?.hasAttribute( 'aria-pressed' ) ).toBe( false );
+	} );
+} );
