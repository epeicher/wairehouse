diff --git c/tests/vitest/arrange.test.ts w/tests/vitest/arrange.test.ts
index 61c9f201..394860d7 100644
--- c/tests/vitest/arrange.test.ts
+++ w/tests/vitest/arrange.test.ts
@@ -108,0 +109,32 @@ describe( 'WindowManager — Arrange (tile + snap)', async () => {
+	test( 'tile() splits 3 windows into thirds, not a 2x2 with a hole', async () => {
+		const wins = [
+			await manager.open( openConfig( 'a' ) ),
+			await manager.open( openConfig( 'b' ) ),
+			await manager.open( openConfig( 'c' ) ),
+		];
+
+		manager.tile();
+
+		// 1568 wide after padding, minus two 12px gaps: 514 each.
+		expect( wins.map( ( w ) => [ w.element.style.left, w.element.style.width ] ) ).toEqual( [
+			[ '16px', '514px' ],
+			[ '542px', '514px' ],
+			[ '1068px', '514px' ],
+		] );
+		expect( wins.map( ( w ) => w.element.style.height ) ).toEqual( [ '868px', '868px', '868px' ] );
+	} );
+
+	test( 'tile() spreads a short last row across the full width', async () => {
+		const wins = [];
+		for ( const id of [ 'a', 'b', 'c', 'd', 'e' ] ) {
+			wins.push( await manager.open( openConfig( id ) ) );
+		}
+
+		manager.tile();
+
+		// 3x2: the second row holds two windows sharing 1568 - 12.
+		const [ d, e ] = wins.slice( 3 );
+		expect( [ d.element.style.left, d.element.style.top, d.element.style.width ] ).toEqual( [ '16px', '456px', '778px' ] );
+		expect( [ e.element.style.left, e.element.style.width ] ).toEqual( [ '806px', '778px' ] );
+	} );
+
