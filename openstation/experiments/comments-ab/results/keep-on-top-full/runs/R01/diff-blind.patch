+
+	public setAlwaysOnTop( windowId: string, enabled: boolean ): boolean {
+		const win = this.getById( windowId );
+		if ( ! win ) {
+			return false;
+		}
+		const next = !! enabled;
+		if ( win.alwaysOnTop === next ) {
+			return true;
+		}
+		win._applyAlwaysOnTop( next );
+		this.applyZOrder();
+		document.dispatchEvent(
+			new CustomEvent( 'os-window-changed', {
+				detail: { windowId: win.id, reason: 'always-on-top', state: win.state },
+			} ),
+		);
+		return true;
+	}
+
+	private isKeptOnTop( win: Window ): boolean {
+		const seen = new Set< Window >();
+		for (
+			let current: Window | undefined = win;
+			current && ! seen.has( current );
+			current = this.ownerOf( current )
+		) {
+			if ( current.alwaysOnTop ) {
+				return true;
+			}
+			seen.add( current );
+		}
+		return false;
+	}
+
+	private applyZOrder(): void {
+		const pinned = this._stack.filter( ( w ) => this.isKeptOnTop( w ) );
+		const rest = this._stack.filter( ( w ) => ! pinned.includes( w ) );
+		[ ...rest, ...pinned ].forEach( ( w, i ) =>
+			w.setZIndex( BASE_Z_INDEX + i ),
+		);
