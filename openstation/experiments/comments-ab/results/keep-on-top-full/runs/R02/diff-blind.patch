index 00000000..ad79e671
--- /dev/null
+++ w/src/window-manager/stacking.ts
@@ -0,0 +1,58 @@
+/**
+ * OpenStation — Window stacking.
+ *
+ * Turns the manager's stack (focus order, last = focused) into the
+ * z-indices the windows paint with. Two bands: ordinary windows, then
+ * the windows kept on top. Each band keeps stack order, so windows
+ * kept on top stack among themselves in normal focus order and still
+ * sit above every ordinary window — including the focused one.
+ *
+ * The stack itself is never reordered for "keep on top". It is what
+ * `getFocused()`, session order and Alt-Tab read, and a focused
+ * ordinary window has to stay focused even while a pinned one covers
+ * part of it.
+ */
+
+import type { Window } from '../window';
+
+/** Base z-index for desktop windows. */
+export const BASE_Z_INDEX = 100;
+
+/**
+ * Whether a window paints in the kept-on-top band: it is pinned
+ * itself, or it is a child of a window that is. A child that stayed
+ * in the lower band would sit behind the pinned owner it blocks.
+ *
+ * @param win     Window to classify.
+ * @param ownerOf The manager's owner lookup.
+ */
+export function isKeptOnTop(
+	win: Window,
+	ownerOf: ( w: Window ) => Window | undefined,
+): boolean {
+	// `seen` guards against a cycle in plugin-declared ownership.
+	const seen = new Set< Window >();
+	for ( let w: Window | undefined = win; w && ! seen.has( w ); w = ownerOf( w ) ) {
+		if ( w.alwaysOnTop ) {
+			return true;
+		}
+		seen.add( w );
+	}
+	return false;
+}
+
+/**
+ * Write every window's z-index from its stack position and band.
+ *
+ * @param stack   The manager's stack, lowest first.
+ * @param ownerOf The manager's owner lookup.
+ */
+export function applyStackZIndices(
+	stack: readonly Window[],
+	ownerOf: ( w: Window ) => Window | undefined,
+): void {
+	stack.forEach( ( w, i ) => {
+		const band = isKeptOnTop( w, ownerOf ) ? stack.length : 0;
+		w.setZIndex( BASE_Z_INDEX + band + i );
+	} );
+}
