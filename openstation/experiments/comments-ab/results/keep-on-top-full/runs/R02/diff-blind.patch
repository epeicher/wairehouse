+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	/** Window ids in painting order, lowest first. */
+	function paintOrder(): string[] {
+		return [ ...manager._stack ]
+			.sort( ( a, b ) => Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ) )
+			.map( ( w ) => w.id );
+	}
+
+	test( 'stays above a window focused or opened after it, without taking focus', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		manager.focus( b );
+		const c = await manager.open( cfg( 'c' ) );
+
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( paintOrder().at( -1 ) ).toBe( 'a' );
+		// Focus is the stack's business, not the band's.
+		expect( c.isFocused() ).toBe( true );
+		expect( manager.getFocused() ).toBe( c );
+	} );
+
+	test( 'several stack in focus order among themselves; off restores normal stacking', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( a );
+		expect( paintOrder() ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( 'c' );
+		manager.setAlwaysOnTop( 'a', false );
+		expect( paintOrder() ).toEqual( [ 'a', 'c', 'b' ] );
+	} );
+
+	test( 'a child of a window kept on top paints above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+		await manager.open( cfg( 'other' ) );
+
+		expect( paintOrder() ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'survives the session round-trip', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const saved = manager.snapshot().windows;
+		expect( saved.find( ( w ) => w.id === 'a' )?.alwaysOnTop ).toBe( true );
+		expect( saved.find( ( w ) => w.id === 'b' ) ).not.toHaveProperty( 'alwaysOnTop' );
+
+		// Restore passes the saved flag back through the open config.
+		const restored = await manager.openNew( cfg( 'a-2', { baseId: 'a', alwaysOnTop: true } ) );
+		expect( restored.alwaysOnTop ).toBe( true );
+		await manager.open( cfg( 'later' ) );
+		expect( paintOrder().at( -1 ) ).toBe( 'a-2' );
+	} );
+} );
