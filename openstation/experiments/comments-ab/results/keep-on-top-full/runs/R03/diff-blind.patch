diff --git c/src/window-manager/stacking.ts w/src/window-manager/stacking.ts
new file mode 100644
index 00000000..a05a4065
--- /dev/null
+++ w/src/window-manager/stacking.ts
@@ -0,0 +1,50 @@
+import { HOOKS, doAction } from '../hooks';
+import type { Window } from '../window';
+import type { WindowManager } from './index';
+
+const BASE_Z_INDEX = 100;
+
+export function isKeptOnTop( mgr: WindowManager, win: Window ): boolean {
+	const seen = new Set< Window >();
+	let current: Window | undefined = win;
+	while ( current && ! seen.has( current ) ) {
+		if ( current.alwaysOnTop ) {
+			return true;
+		}
+		seen.add( current );
+		current = mgr.ownerOf( current );
+	}
+	return false;
+}
+
+export function applyStackOrder( mgr: WindowManager ): void {
+	const below: Window[] = [];
+	const above: Window[] = [];
+	for ( const w of mgr._stack ) {
+		( isKeptOnTop( mgr, w ) ? above : below ).push( w );
+	}
+	[ ...below, ...above ].forEach( ( w, i ) =>
+		w.setZIndex( BASE_Z_INDEX + i ),
+	);
+}
+
+export function setAlwaysOnTop(
+	mgr: WindowManager,
+	windowId: string,
+	enabled: boolean,
+): boolean {
+	const win = mgr.getById( windowId );
+	if ( ! win ) {
+		return false;
+	}
+	if ( ! win._applyAlwaysOnTop( !! enabled ) ) {
+		return true;
+	}
+	applyStackOrder( mgr );
+	const detail = { windowId: win.id, alwaysOnTop: win.alwaysOnTop };
+	document.dispatchEvent(
+		new CustomEvent( 'os-window-always-on-top-changed', { detail } ),
+	);
+	doAction( HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED, detail );
+	return true;
+}
diff --git c/src/window/always-on-top.ts w/src/window/always-on-top.ts
new file mode 100644
index 00000000..6f97d439
--- /dev/null
+++ w/src/window/always-on-top.ts
@@ -0,0 +1,20 @@
+import { __ } from './../i18n';
+import type { Window } from './index';
+
+export const ALWAYS_ON_TOP_CLASS = 'os-window--always-on-top';
+
+export function syncAlwaysOnTopControl( win: Window ): void {
+	const btn = win.element.querySelector< HTMLElement >(
+		'.os-window__btn--always-on-top',
+	);
+	if ( ! btn ) {
+		return;
+	}
+	const on = win.alwaysOnTop;
+	btn.toggleAttribute( 'active', on );
+	btn.setAttribute( 'aria-pressed', on ? 'true' : 'false' );
+	btn.setAttribute(
+		'aria-label',
+		on ? __( 'Stop keeping on top' ) : __( 'Keep on top' ),
+	);
+}
