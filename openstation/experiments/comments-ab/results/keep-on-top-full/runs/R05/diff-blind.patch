+/** Window ids in painted order (by z-index), lowest first. */
+function paintOrder( manager: WindowManager ): string[] {
+	return [ ...manager._stack ]
+		.sort( ( a, b ) => Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ) )
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		_resetWindowControlRegistryForTests();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'stays above windows focused or opened after it, without taking focus', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'pinned' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const a = manager.getById( 'a' )!;
+		manager.focus( a );
+		await manager.open( cfg( 'b' ) );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'a', 'b', 'pinned' ] );
+		expect( manager.getFocused()?.id ).toBe( 'b' );
+
+		// Back to its focus-order slot: lowest, since `a` and `b` were
+		// both focused after it.
+		manager.setAlwaysOnTop( 'pinned', false );
+		expect( paintOrder( manager ) ).toEqual( [ 'pinned', 'a', 'b' ] );
+	} );
+
+	test( 'several kept-on-top windows stack among themselves in focus order', async () => {
+		await manager.open( cfg( 'p1' ) );
+		await manager.open( cfg( 'p2' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'p1', true );
+		manager.setAlwaysOnTop( 'p2', true );
+
+		manager.focus( 'p1' );
+		expect( paintOrder( manager ) ).toEqual( [ 'plain', 'p2', 'p1' ] );
+	} );
+
+	test( 'a child rides above its kept-on-top owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'the title-bar pin toggles it and reflects the state', async () => {
+		registerBuiltInControls();
+		const win = await manager.open( cfg( 'w' ) );
+		const pin = win.element.querySelector( '.os-window__btn--always-on-top' )!;
+
+		pin.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( win.alwaysOnTop ).toBe( true );
+		expect( pin.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+	} );
+
+	test( 'round-trips through the session snapshot', async () => {
+		await manager.open( cfg( 'plain' ) );
+		await manager.open( cfg( 'pinned' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const saved = manager.snapshot().windows;
+		expect( saved.find( ( w ) => w.id === 'pinned' )?.alwaysOnTop ).toBe( true );
+		expect( saved.find( ( w ) => w.id === 'plain' ) ).not.toHaveProperty( 'alwaysOnTop' );
+
+		// Restore passes the flag back as open-time config.
+		const restored = await manager.openNew( cfg( 'restored', { alwaysOnTop: true } ) );
+		await manager.open( cfg( 'later' ) );
+		expect( restored.alwaysOnTop ).toBe( true );
+		expect( paintOrder( manager ).slice( -2 ) ).toEqual( [ 'pinned', 'restored' ] );
+	} );
+} );
