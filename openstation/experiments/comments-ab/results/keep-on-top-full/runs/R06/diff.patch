+		expect( pin ).not.toBeNull();
+
+		pin!.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( pin!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe( true );
+		expect( paintOrder() ).toEqual( [ 'b', 'a' ] );
+		const detail = ( changed.mock.calls[ 0 ][ 0 ] as CustomEvent ).detail;
+		expect( detail ).toMatchObject( { windowId: 'a', reason: 'always-on-top' } );
+		document.removeEventListener( 'os-window-changed', changed );
+
+		pin!.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
