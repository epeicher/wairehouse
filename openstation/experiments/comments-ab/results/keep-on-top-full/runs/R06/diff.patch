diff --git c/src/window-manager/always-on-top.ts w/src/window-manager/always-on-top.ts
new file mode 100644
index 00000000..feb3e801
--- /dev/null
+++ w/src/window-manager/always-on-top.ts
@@ -0,0 +1,29 @@
+import type { Window } from '../window';
+
+export function isKeptOnTop(
+	win: Window,
+	ownerOf: ( w: Window ) => Window | undefined,
+): boolean {
+	const seen = new Set< Window >();
+	let current: Window | undefined = win;
+	while ( current && ! seen.has( current ) ) {
+		if ( current.alwaysOnTop ) {
+			return true;
+		}
+		seen.add( current );
+		current = ownerOf( current );
+	}
+	return false;
+}
+
+export function paintOrder(
+	stack: readonly Window[],
+	ownerOf: ( w: Window ) => Window | undefined,
+): Window[] {
+	const normal: Window[] = [];
+	const onTop: Window[] = [];
+	for ( const win of stack ) {
+		( isKeptOnTop( win, ownerOf ) ? onTop : normal ).push( win );
+	}
+	return [ ...normal, ...onTop ];
+}
