diff --git c/tests/vitest/window-manager-always-on-top.test.ts w/tests/vitest/window-manager-always-on-top.test.ts
new file mode 100644
index 00000000..45ad146a
--- /dev/null
+++ w/tests/vitest/window-manager-always-on-top.test.ts
@@ -0,0 +1,222 @@
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { WindowManager } from '../../src/window-manager';
+import type { Window } from '../../src/window';
+import type { DesktopConfig } from '../../src/types';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `http://example.test/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+function z( win: Window ): number {
+	return Number( win.element.style.zIndex );
+}
+
+function visualOrder( manager: WindowManager ): string[] {
+	return manager
+		.getAll()
+		.sort( ( a, b ) => z( a ) - z( b ) )
+		.map( ( w ) => w.id );
+}
+
+describe( 'WindowManager — keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'a pinned window stays above a window that is focused later', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+
+		expect( manager.setAlwaysOnTop( 'a', true ) ).toBe( true );
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( visualOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.focus( b );
+		expect( b.isFocused() ).toBe( true );
+		expect( manager.getFocused() ).toBe( b );
+		expect( visualOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'a pinned window stays above a newly opened window', async () => {
+		await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const c = await manager.open( cfg( 'c' ) );
+
+		expect( c.isFocused() ).toBe( true );
+		expect( visualOrder( manager ) ).toEqual( [ 'c', 'a' ] );
+	} );
+
+	test( 'pinned windows stack among themselves in focus order', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		expect( visualOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+
+		manager.focus( a );
+		expect( visualOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( 'c' );
+		expect( visualOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( b );
+		expect( visualOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.focus( b );
+		expect( visualOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.setAlwaysOnTop( 'a', false );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( visualOrder( manager ) ).toEqual( [ 'a', 'b' ] );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe(
+			false,
+		);
+	} );
+
+	test( 'owned children of a pinned window ride above it', async () => {
+		await manager.open( cfg( 'owner' ) );
+		const child = await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( child.alwaysOnTop ).toBe( false );
+		expect( visualOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'toggling marks the window, syncs the pin button and emits a change', async () => {
+		registerBuiltInControls();
+		const a = await manager.open( cfg( 'a' ) );
+		const changes: unknown[] = [];
+		const onChange = ( e: Event ): void => {
+			changes.push( ( e as CustomEvent ).detail );
+		};
+		document.addEventListener( 'os-window-changed', onChange );
+
+		a.toggleAlwaysOnTop();
+
+		document.removeEventListener( 'os-window-changed', onChange );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe(
+			true,
+		);
+		const pin = a.element.querySelector( '.os-window__btn--always-on-top' );
+		expect( pin?.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( pin?.hasAttribute( 'active' ) ).toBe( true );
+		expect( changes ).toContainEqual(
+			expect.objectContaining( { windowId: 'a', reason: 'always-on-top' } ),
+		);
+	} );
+
+	test( 'returns false for an unknown window id', () => {
+		expect( manager.setAlwaysOnTop( 'missing', true ) ).toBe( false );
+	} );
+
+	test( 'the flag is part of the session snapshot and seeds new windows', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const windows = manager.snapshot().windows;
+		expect( windows.find( ( w ) => w.id === 'a' )?.alwaysOnTop ).toBe( true );
+		expect( windows.find( ( w ) => w.id === 'b' ) ).not.toHaveProperty(
+			'alwaysOnTop',
+		);
+
+		const restored = await manager.open( cfg( 'r', { alwaysOnTop: true } ) );
+		expect( restored.alwaysOnTop ).toBe( true );
+		await manager.open( cfg( 'later' ) );
+		expect( visualOrder( manager ).at( -1 ) ).toBe( 'r' );
+	} );
+
+	test( 'survives a reload through restoreSession', async () => {
+		const adminUrl = `${ window.location.origin }/wp-admin/`;
+		await manager.open( cfg( 'a', { url: `${ adminUrl }edit.php` } ) );
+		await manager.open( cfg( 'b', { url: `${ adminUrl }upload.php` } ) );
+		manager.setAlwaysOnTop( 'a', true );
+		const session = manager.snapshot();
+
+		const reloaded = new WindowManager( desktop );
+		await restoreSession(
+			reloaded,
+			{
+				adminUrl,
+				currentPage: `${ adminUrl }index.php`,
+				dockItems: [],
+				session,
+			} as unknown as DesktopConfig,
+			desktop,
+		);
+
+		try {
+			expect( reloaded.getById( 'a' )?.alwaysOnTop ).toBe( true );
+			expect( reloaded.getById( 'b' )?.alwaysOnTop ).toBe( false );
+			expect( visualOrder( reloaded ) ).toEqual( [ 'b', 'a' ] );
+		} finally {
+			for ( const w of reloaded.getAll() ) {
+				w.destroy();
+			}
+			reloaded.destroy();
+		}
+	} );
+} );
