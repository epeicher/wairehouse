diff --git c/tests/vitest/window-always-on-top.test.ts w/tests/vitest/window-always-on-top.test.ts
new file mode 100644
index 00000000..0d9bb18e
--- /dev/null
+++ w/tests/vitest/window-always-on-top.test.ts
@@ -0,0 +1,246 @@
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { WindowManager } from '../../src/window-manager';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+import type { DesktopConfig, Session, SessionWindow } from '../../src/types';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+function visualOrder( manager: WindowManager ): string[] {
+	return manager
+		.getAll()
+		.sort(
+			( a, b ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		_resetWindowControlRegistryForTests();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'a kept-on-top window stays above a window that takes focus', async () => {
+		const pinned = await manager.open( cfg( 'pinned' ) );
+		const other = await manager.open( cfg( 'other' ) );
+
+		expect( manager.setAlwaysOnTop( 'pinned', true ) ).toBe( true );
+		expect( pinned.alwaysOnTop ).toBe( true );
+		expect( visualOrder( manager ) ).toEqual( [ 'other', 'pinned' ] );
+
+		manager.focus( other );
+
+		expect( other.isFocused() ).toBe( true );
+		expect( pinned.isFocused() ).toBe( false );
+		expect( visualOrder( manager ) ).toEqual( [ 'other', 'pinned' ] );
+	} );
+
+	test( 'a newly opened window opens below kept-on-top windows', async () => {
+		await manager.open( cfg( 'pinned' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const fresh = await manager.open( cfg( 'fresh' ) );
+
+		expect( fresh.isFocused() ).toBe( true );
+		expect( visualOrder( manager ) ).toEqual( [ 'fresh', 'pinned' ] );
+	} );
+
+	test( 'several kept-on-top windows stack among themselves by focus', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( a );
+		expect( visualOrder( manager ) ).toEqual( [ 'plain', 'b', 'a' ] );
+
+		manager.focus( b );
+		expect( visualOrder( manager ) ).toEqual( [ 'plain', 'a', 'b' ] );
+
+		manager.focus( 'plain' );
+		expect( visualOrder( manager ) ).toEqual( [ 'plain', 'a', 'b' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		const pinned = await manager.open( cfg( 'pinned' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		manager.setAlwaysOnTop( 'pinned', false );
+
+		expect( pinned.alwaysOnTop ).toBe( false );
+		expect( visualOrder( manager ) ).toEqual( [ 'pinned', 'other' ] );
+	} );
+
+	test( 'a child of a kept-on-top window still sits above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		const other = await manager.open( cfg( 'other' ) );
+
+		manager.focus( other );
+
+		expect( visualOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'unknown ids and no-op changes report false', async () => {
+		await manager.open( cfg( 'win' ) );
+
+		expect( manager.setAlwaysOnTop( 'missing', true ) ).toBe( false );
+		expect( manager.setAlwaysOnTop( 'win', false ) ).toBe( false );
+	} );
+
+	test( 'the change is announced so the session gets saved', async () => {
+		await manager.open( cfg( 'win' ) );
+		const reasons: string[] = [];
+		const onChange = ( e: Event ): void => {
+			reasons.push( ( e as CustomEvent< { reason: string } > ).detail.reason );
+		};
+		document.addEventListener( 'os-window-changed', onChange );
+
+		manager.setAlwaysOnTop( 'win', true );
+
+		document.removeEventListener( 'os-window-changed', onChange );
+		expect( reasons ).toEqual( [ 'always-on-top' ] );
+	} );
+
+	test( 'the title-bar pin toggles the state and reflects it', async () => {
+		registerBuiltInControls();
+		const win = await manager.open( cfg( 'win' ) );
+		await manager.open( cfg( 'other' ) );
+		const pin = (): HTMLElement =>
+			win.element.querySelector< HTMLElement >(
+				'.os-window__btn--always-on-top',
+			)!;
+
+		expect( pin() ).not.toBeNull();
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( win.alwaysOnTop ).toBe( true );
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( visualOrder( manager ) ).toEqual( [ 'other', 'win' ] );
+
+		win.repaintWindowControls();
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( win.alwaysOnTop ).toBe( false );
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+	} );
+
+	test( 'the state is saved in the session snapshot', async () => {
+		await manager.open( cfg( 'pinned' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const byId = Object.fromEntries(
+			manager.snapshot().windows.map( ( w ) => [ w.id, w ] ),
+		);
+
+		expect( byId.pinned.alwaysOnTop ).toBe( true );
+		expect( byId.plain ).not.toHaveProperty( 'alwaysOnTop' );
+	} );
+
+	test( 'restoring a session brings the state back', async () => {
+		const sessionWindow = ( id: string, patch: Partial< SessionWindow > = {} ): SessionWindow => ( {
+			id,
+			baseId: id,
+			desktopId: 'desktop-1',
+			url: `${ ORIGIN }/wp-admin/${ id }.php`,
+			title: id,
+			icon: 'dashicons-admin-generic',
+			state: 'normal',
+			x: 100,
+			y: 80,
+			width: 900,
+			height: 600,
+			...patch,
+		} );
+		const session: Session = {
+			windows: [
+				sessionWindow( 'pinned', { alwaysOnTop: true } ),
+				sessionWindow( 'plain' ),
+			],
+			desktops: [ { id: 'desktop-1', label: 'Desktop 1' } ],
+			activeDesktop: 'desktop-1',
+			focused: 'plain',
+			updated: 123,
+		};
+		const config = {
+			adminUrl: `${ ORIGIN }/wp-admin/`,
+			currentPage: `${ ORIGIN }/wp-admin/`,
+			currentTitle: '',
+			currentIcon: '',
+			dockItems: [],
+			session,
+		} as unknown as DesktopConfig;
+
+		await restoreSession( manager, config, desktop );
+
+		expect( manager.getById( 'pinned' )?.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'plain' )?.alwaysOnTop ).toBe( false );
+		expect( manager.getFocused()?.id ).toBe( 'plain' );
+		expect( visualOrder( manager ) ).toEqual( [ 'plain', 'pinned' ] );
+	} );
+} );
