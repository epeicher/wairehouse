+	public setAlwaysOnTop( windowId: string, enabled: boolean ): boolean {
+		const win = this.getById( windowId );
+		if ( ! win ) {
+			return false;
+		}
+		if ( ! win._applyAlwaysOnTop( !! enabled ) ) {
+			return false;
+		}
+		this.applyZOrder();
+		return true;
+	}
+
+	private isKeptOnTop( win: Window ): boolean {
+		const seen = new Set< Window >();
+		for (
+			let current: Window | undefined = win;
+			current && ! seen.has( current );
+			current = this.ownerOf( current )
+		) {
+			if ( current.alwaysOnTop ) {
+				return true;
+			}
+			seen.add( current );
+		}
+		return false;
+	}
+
+	private applyZOrder(): void {
+		const normal: Window[] = [];
+		const onTop: Window[] = [];
+		for ( const w of this._stack ) {
+			( this.isKeptOnTop( w ) ? onTop : normal ).push( w );
+		}
+		[ ...normal, ...onTop ].forEach( ( w, i ) =>
+			w.setZIndex( BASE_Z_INDEX + i ),
+		);
