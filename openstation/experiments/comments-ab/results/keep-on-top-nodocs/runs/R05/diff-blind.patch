+		await manager.open( cfg( 'late' ) );
+		manager.focus( other );
+
+		expect( other.isFocused() ).toBe( true );
+		expect( manager.getFocused() ).toBe( other );
+		expect( painted() ).toEqual( [ 'late', 'other', 'pinned' ] );
+	} );
+
+	test( 'several kept on top stack in focus order; releasing one restores it', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( a );
+		expect( painted() ).toEqual( [ 'plain', 'b', 'a' ] );
+
+		manager.focus( 'plain' );
+		manager.setAlwaysOnTop( 'a', false );
+
+		expect( manager.getById( 'a' )?.alwaysOnTop ).toBe( false );
+		expect( painted() ).toEqual( [ 'a', 'plain', 'b' ] );
+	} );
+
+	test( 'a child of a kept-on-top owner stays above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+		await manager.open( cfg( 'other' ) );
+
+		expect( painted() ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'the title-bar pin toggles it and reflects the state', async () => {
+		registerBuiltInControls();
+		const win = await manager.open( cfg( 'pinned' ) );
+		const pin = () =>
+			win.element.querySelector( '.os-window__btn--always-on-top' ) as HTMLElement;
+		const changes: unknown[] = [];
+		const onChange = ( e: Event ) => changes.push( ( e as CustomEvent ).detail );
+		document.addEventListener( 'os-window-always-on-top-changed', onChange );
+
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( win.alwaysOnTop ).toBe( true );
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( changes ).toEqual( [ { windowId: 'pinned', alwaysOnTop: true } ] );
+
+		// A controls repaint rebuilds the button; the state must survive it.
+		win.repaintWindowControls();
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+		expect( win.alwaysOnTop ).toBe( false );
+		document.removeEventListener( 'os-window-always-on-top-changed', onChange );
+	} );
+
+	test( 'round-trips through the session snapshot', async () => {
+		await manager.open( cfg( 'pinned' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const saved = manager.snapshot().windows;
+		expect( saved.find( ( w ) => w.id === 'pinned' )?.alwaysOnTop ).toBe( true );
+		expect( saved.find( ( w ) => w.id === 'plain' ) ).not.toHaveProperty( 'alwaysOnTop' );
+
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		manager._stack.length = 0;
+
+		// What restore hands `openNew()` for a saved kept-on-top window.
+		const restored = await manager.openNew( cfg( 'pinned', { alwaysOnTop: true } ) );
+		await manager.openNew( cfg( 'plain' ) );
+
+		expect( restored.alwaysOnTop ).toBe( true );
+		expect( painted() ).toEqual( [ 'plain', 'pinned' ] );
+	} );
+} );
