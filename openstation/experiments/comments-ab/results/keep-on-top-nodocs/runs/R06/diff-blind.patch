diff --git c/tests/vitest/window-always-on-top.test.ts w/tests/vitest/window-always-on-top.test.ts
new file mode 100644
index 00000000..df4bdb2d
--- /dev/null
+++ w/tests/vitest/window-always-on-top.test.ts
@@ -0,0 +1,217 @@
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { WindowManager } from '../../src/window-manager';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import type { Window } from '../../src/window';
+import type { DesktopConfig, Session, SessionWindow } from '../../src/types';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+function z( win: Window ): number {
+	return Number( win.element.style.zIndex );
+}
+
+function paintOrder( manager: WindowManager ): string[] {
+	return manager
+		.getAll()
+		.sort( ( a, b ) => z( a ) - z( b ) )
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		_resetWindowControlRegistryForTests();
+		registerBuiltInControls();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'a pinned window stays above windows that are focused or opened later', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+
+		manager.setAlwaysOnTop( 'a', true );
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.focus( b );
+		expect( b.isFocused() ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		const c = await manager.open( cfg( 'c' ) );
+		expect( c.isFocused() ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'c', 'a' ] );
+	} );
+
+	test( 'pinned windows stack among themselves in focus order', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+
+		manager.focus( a );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( 'c' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+		expect( b.alwaysOnTop ).toBe( true );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'a', false );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( [ 'a', 'b' ] );
+
+		manager.focus( a );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'a child of a pinned window stays above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		const other = await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+		manager.focus( other );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'the title bar pin button toggles the state and reflects it', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		const pin = a.element.querySelector< HTMLElement >(
+			'.os-window__controls .os-window__btn--pin',
+		);
+		expect( pin ).not.toBeNull();
+		expect( pin!.nextElementSibling?.classList.contains( 'os-window__btn--minimize' ) ).toBe( true );
+		expect( pin!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		pin!.dispatchEvent( new CustomEvent( 'os-button-activate', { bubbles: true } ) );
+
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( pin!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		pin!.dispatchEvent( new CustomEvent( 'os-button-activate', { bubbles: true } ) );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( pin!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+	} );
+
+	test( 'toggling emits os-window-changed so the session is saved', async () => {
+		await manager.open( cfg( 'a' ) );
+		const reasons: string[] = [];
+		const listener = ( e: Event ): void => {
+			reasons.push( ( e as CustomEvent< { reason: string } > ).detail.reason );
+		};
+		document.addEventListener( 'os-window-changed', listener );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'a', true );
+		document.removeEventListener( 'os-window-changed', listener );
+
+		expect( reasons ).toEqual( [ 'always-on-top' ] );
+	} );
+
+	test( 'the flag round-trips through the session snapshot and restore', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const snapshot = manager.snapshot();
+		expect( snapshot.windows.find( ( w ) => w.id === 'a' )?.alwaysOnTop ).toBe( true );
+		expect( snapshot.windows.find( ( w ) => w.id === 'b' ) ).not.toHaveProperty( 'alwaysOnTop' );
+
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+
+		const session: Session = {
+			...snapshot,
+			windows: snapshot.windows.map( ( w ): SessionWindow => ( { ...w } ) ),
+		};
+		await restoreSession(
+			manager,
+			{
+				adminUrl: `${ ORIGIN }/wp-admin/`,
+				currentPage: `${ ORIGIN }/wp-admin/`,
+				currentTitle: '',
+				currentIcon: '',
+				dockItems: [],
+				session,
+			} as unknown as DesktopConfig,
+			desktop,
+		);
+
+		expect( manager.getById( 'a' )?.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'b' )?.alwaysOnTop ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+} );
