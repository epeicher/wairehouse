+	 * `HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED` with
+	 * `{ windowId, alwaysOnTop }`, and saves the session. Unknown ids
+	 * and no-op calls fire nothing.
+	 *
+	 * @param winOrId Window, or its id.
+	 * @param enabled Whether to keep it on top.
+	 */
+	public setAlwaysOnTop( winOrId: Window | string, enabled: boolean ): void {
