+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( 'b' );
+		manager.focus( 'c' );
+		expect( paintOrder() ).toEqual( [ 'c', 'a', 'b' ] );
+
+		manager.focus( a );
+		expect( paintOrder() ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.setAlwaysOnTop( 'b', false );
+		manager.focus( 'c' );
+		expect( paintOrder() ).toEqual( [ 'b', 'c', 'a' ] );
+	} );
+
+	test( 'a child of a pinned owner paints above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( paintOrder() ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'the title-bar pin toggles it, and the button, events and session follow', async () => {
+		const win = await manager.open( cfg( 'pinned' ) );
+		const events: unknown[] = [];
+		const onChange = ( e: Event ): void => {
+			events.push( ( e as CustomEvent ).detail );
+		};
+		document.addEventListener( 'os-window-always-on-top-changed', onChange );
+
+		const pin = (): HTMLElement =>
+			win.element.querySelector(
+				'.os-window__btn--always-on-top',
+			) as HTMLElement;
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( win.alwaysOnTop ).toBe( true );
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( manager.snapshot().windows[ 0 ].alwaysOnTop ).toBe( true );
+
+		// A controls repaint rebuilds the button; it must come back pressed.
+		win.repaintWindowControls();
+		expect( pin().getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+		pin().dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+		document.removeEventListener( 'os-window-always-on-top-changed', onChange );
+
+		expect( win.alwaysOnTop ).toBe( false );
+		expect( manager.snapshot().windows[ 0 ] ).not.toHaveProperty(
+			'alwaysOnTop',
+		);
+		expect( events ).toEqual( [
+			{ windowId: 'pinned', alwaysOnTop: true },
+			{ windowId: 'pinned', alwaysOnTop: false },
+		] );
+	} );
+} );
