+	private updateKeepOnTopButtonState(): void {
+		const btn = this.element.querySelector< HTMLElement >(
+			'.os-window__btn--keep-on-top',
+		);
+		if ( ! btn ) {
+			return;
+		}
+		btn.toggleAttribute( 'active', this._alwaysOnTop );
+		btn.setAttribute( 'aria-pressed', this._alwaysOnTop ? 'true' : 'false' );
