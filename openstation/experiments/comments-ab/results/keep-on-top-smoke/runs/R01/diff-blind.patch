+	public _applyAlwaysOnTop( enabled: boolean ): boolean {
+		if ( this._alwaysOnTop === enabled ) {
+			return false;
+		}
+		this._alwaysOnTop = enabled;
+		this.config.alwaysOnTop = enabled;
+		this.element.classList.toggle( 'os-window--always-on-top', enabled );
+		this.updateKeepOnTopButtonState();
+		return true;
+	}
