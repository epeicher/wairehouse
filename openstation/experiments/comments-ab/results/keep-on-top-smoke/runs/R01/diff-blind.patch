diff --git c/src/window-manager/stacking.ts w/src/window-manager/stacking.ts
new file mode 100644
index 00000000..6e1fe18e
--- /dev/null
+++ w/src/window-manager/stacking.ts
@@ -0,0 +1,48 @@
+import type { Window } from '../window';
+import type { WindowManager } from './index';
+
+const BASE_Z_INDEX = 100;
+
+function isKeptOnTop( manager: WindowManager, win: Window ): boolean {
+	const seen = new Set< Window >();
+	for (
+		let current: Window | undefined = win;
+		current && ! seen.has( current );
+		current = manager.ownerOf( current )
+	) {
+		if ( current.alwaysOnTop ) {
+			return true;
+		}
+		seen.add( current );
+	}
+	return false;
+}
+
+export function applyZOrder( manager: WindowManager ): void {
+	const onTop = manager._stack.filter( ( w ) => isKeptOnTop( manager, w ) );
+	const normal = manager._stack.filter( ( w ) => ! onTop.includes( w ) );
+	[ ...normal, ...onTop ].forEach( ( w, i ) => {
+		w.setZIndex( BASE_Z_INDEX + i );
+	} );
+}
+
+export function setAlwaysOnTop(
+	manager: WindowManager,
+	windowId: string,
+	enabled: boolean,
+): boolean {
+	const win = manager.getById( windowId );
+	if ( ! win ) {
+		return false;
+	}
+	if ( ! win._applyAlwaysOnTop( !! enabled ) ) {
+		return true;
+	}
+	applyZOrder( manager );
+	document.dispatchEvent(
+		new CustomEvent( 'os-window-changed', {
+			detail: { windowId: win.id, reason: 'always-on-top', state: win.state },
+		} ),
+	);
+	return true;
+}
