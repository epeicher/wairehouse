 } );
+
+function paintOrder( manager: WindowManager ): string[] {
+	return manager
+		.getAll()
+		.sort(
+			( a, b ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	test( 'a kept window stays above windows focused or opened after it', async () => {
+		const pinned = await manager.open( cfg( 'pinned' ) );
+		const other = await manager.open( cfg( 'other' ) );
+
+		expect( manager.setAlwaysOnTop( 'pinned', true ) ).toBe( true );
+		expect( pinned.alwaysOnTop ).toBe( true );
+		manager.focus( other );
+		await manager.open( cfg( 'late' ) );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'late', 'pinned' ] );
+		expect( manager.getFocused()?.id ).toBe( 'late' );
+	} );
+
+	test( 'kept windows stack among themselves in focus order', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( 'a' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( 'b' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		const pinned = await manager.open( cfg( 'pinned' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		manager.setAlwaysOnTop( 'pinned', false );
+
+		expect( pinned.alwaysOnTop ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( [ 'pinned', 'other' ] );
+	} );
+
+	test( 'a child of a kept owner stays above it', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'the flag round-trips through the session snapshot', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const saved = manager.snapshot().windows;
+		expect( saved.find( ( w ) => w.id === 'a' )?.alwaysOnTop ).toBe( true );
+		expect( saved.find( ( w ) => w.id === 'b' ) ).not.toHaveProperty(
+			'alwaysOnTop',
+		);
+
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		manager = new WindowManager( desktop );
+		const restored = await manager.open( cfg( 'a', { alwaysOnTop: true } ) );
+		await manager.open( cfg( 'b' ) );
+
+		expect( restored.alwaysOnTop ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'an unknown id is refused', () => {
+		expect( manager.setAlwaysOnTop( 'nope', true ) ).toBe( false );
+	} );
+} );
