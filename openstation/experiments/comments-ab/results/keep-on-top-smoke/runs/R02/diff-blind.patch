+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( drawnOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'only a real change fires the change event', async () => {
+		await manager.open( cfg( 'w' ) );
+		const seen = vi.fn();
+		document.addEventListener( 'os-window-always-on-top-changed', seen );
+
+		manager.setAlwaysOnTop( 'w', true );
+		manager.setAlwaysOnTop( 'w', true );
+		manager.setAlwaysOnTop( 'missing', true );
+
+		document.removeEventListener( 'os-window-always-on-top-changed', seen );
+		expect( seen ).toHaveBeenCalledTimes( 1 );
+		expect( ( seen.mock.calls[ 0 ][ 0 ] as CustomEvent ).detail ).toEqual( {
+			windowId: 'w',
+			alwaysOnTop: true,
+		} );
+	} );
+
+	test( 'survives a session round-trip', async () => {
+		const origin = window.location.origin;
+		const pageUrl = ( id: string ): string => `${ origin }/wp-admin/${ id }.php`;
+		await manager.open( cfg( 'pinned', { url: pageUrl( 'pinned' ) } ) );
+		await manager.open( cfg( 'plain', { url: pageUrl( 'plain' ) } ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		const session = manager.snapshot();
+		expect(
+			session.windows.map( ( w ) => [ w.id, w.alwaysOnTop ?? false ] ),
+		).toEqual( [
+			[ 'pinned', true ],
+			[ 'plain', false ],
+		] );
+
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		manager = new WindowManager( desktop );
+		await restoreSession(
+			manager,
+			{
+				adminUrl: `${ origin }/wp-admin/`,
+				dockItems: [],
+				session,
+			} as unknown as DesktopConfig,
+			desktop,
+		);
+
+		expect( manager.getById( 'pinned' )?.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'plain' )?.alwaysOnTop ).toBe( false );
+		expect( drawnOrder( manager ).at( -1 ) ).toBe( 'pinned' );
+	} );
+} );
