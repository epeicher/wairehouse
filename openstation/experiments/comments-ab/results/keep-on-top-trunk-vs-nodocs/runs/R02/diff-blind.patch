+
+describe( 'keep on top — session', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	test( 'the snapshot carries the flag, and only for windows that have it', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const byId = Object.fromEntries(
+			manager.snapshot().windows.map( ( w ) => [ w.id, w ] ),
+		);
+
+		expect( byId.a.alwaysOnTop ).toBe( true );
+		expect( 'alwaysOnTop' in byId.b ).toBe( false );
+	} );
+
+	test( 'a reload brings the window back kept on top', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.focus( 'b' );
+		const saved = manager.snapshot();
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+
+		const fresh = new WindowManager( desktop );
+		manager = fresh;
+		await restoreSession(
+			fresh,
+			{
+				adminUrl: `${ ORIGIN }/wp-admin/`,
+				currentPage: `${ ORIGIN }/wp-admin/`,
+				dockItems: [],
+				session: saved,
+			} as unknown as DesktopConfig,
+			desktop,
+		);
+
+		expect( fresh.getById( 'a' )?.alwaysOnTop ).toBe( true );
+		expect( fresh.getById( 'b' )?.alwaysOnTop ).toBe( false );
+		expect( fresh.getFocused()?.id ).toBe( 'b' );
+		expect( paintOrder( fresh ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'native windows get the flag in their restore state', async () => {
+		const native: SessionWindow = {
+			id: 'my-native',
+			baseId: 'my-native',
+			desktopId: 'desktop-1',
+			native: true,
+			url: '#my-native',
+			title: 'Native',
+			icon: 'dashicons-admin-generic',
+			state: 'normal',
+			x: 10,
+			y: 10,
+			width: 400,
+			height: 300,
+			alwaysOnTop: true,
+		};
+		const seen: Array< NativeWindowRestoreState | undefined > = [];
+
+		await restoreSession(
+			manager,
+			{
+				adminUrl: `${ ORIGIN }/wp-admin/`,
+				currentPage: `${ ORIGIN }/wp-admin/`,
+				dockItems: [],
+				session: {
+					windows: [ native ],
+					desktops: [ { id: 'desktop-1', label: 'Desktop 1' } ],
+					activeDesktop: 'desktop-1',
+					focused: '',
+					updated: 1,
+				},
+			} as unknown as DesktopConfig,
+			desktop,
+			( _id, _baseId, state ) => {
+				seen.push( state );
+				return false;
+			},
+		);
+
+		expect( seen[ 0 ]?.alwaysOnTop ).toBe( true );
+	} );
+} );
