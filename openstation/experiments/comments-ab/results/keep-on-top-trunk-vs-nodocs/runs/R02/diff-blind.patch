diff --git c/tests/vitest/window-always-on-top.test.ts w/tests/vitest/window-always-on-top.test.ts
new file mode 100644
index 00000000..677c926d
--- /dev/null
+++ w/tests/vitest/window-always-on-top.test.ts
@@ -0,0 +1,376 @@
+/**
+ * "Keep on top".
+ *
+ * A window kept on top stacks above every window that isn't, whichever
+ * of them is focused or newly opened. Several can be kept on top at
+ * once and stack among themselves in focus order. Focus itself is not
+ * part of the deal: the stack top is still the focused window, it just
+ * may paint under a kept-on-top one.
+ *
+ * The tests pin the stacking against z-index — what the user sees —
+ * rather than `_stack`, which stays in focus order on purpose. They
+ * also cover the title-bar pin and the round trip through the session.
+ */
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { HOOKS } from '../../src/hooks';
+import type { NativeWindowRestoreState } from '../../src/native-windows';
+import {
+	_resetWindowControlRegistryForTests,
+} from '../../src/window-chrome/controls/registry';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { WindowManager } from '../../src/window-manager';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+import type { DesktopConfig, SessionWindow } from '../../src/types';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+/** Window ids in painted order — lowest z-index first. */
+function paintOrder( manager: WindowManager ): string[] {
+	return [ ...manager.getAll() ]
+		.sort(
+			( a, b ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top — stacking', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	test( 'stays above a window that takes focus', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+
+		manager.setAlwaysOnTop( 'a', true );
+		manager.focus( 'b' );
+
+		expect( manager.getFocused()?.id ).toBe( 'b' );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+		expect( a.alwaysOnTop ).toBe( true );
+	} );
+
+	test( 'stays above a window opened after it', async () => {
+		await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const b = await manager.open( cfg( 'b' ) );
+
+		expect( b.isFocused() ).toBe( true );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'does not move focus when turned on', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+
+		manager.setAlwaysOnTop( 'a', true );
+
+		expect( b.isFocused() ).toBe( true );
+		expect( a.isFocused() ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'several kept on top stack among themselves in focus order', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( 'a' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( 'b' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+
+		manager.focus( 'c' );
+		expect( paintOrder( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.focus( 'b' );
+
+		manager.setAlwaysOnTop( 'a', false );
+
+		expect( manager.getById( 'a' )?.alwaysOnTop ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( [ 'a', 'b' ] );
+		// And it is an ordinary window again: focus brings it up.
+		manager.focus( 'a' );
+		expect( paintOrder( manager ) ).toEqual( [ 'b', 'a' ] );
+		manager.focus( 'b' );
+		expect( paintOrder( manager ) ).toEqual( [ 'a', 'b' ] );
+	} );
+
+	test( 'raise() cannot lift a window over one kept on top', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		manager.raise( 'b' );
+
+		expect( paintOrder( manager ).at( -1 ) ).toBe( 'a' );
+	} );
+
+	test( 'a child of a kept-on-top owner stays above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'reports, fires the hook and the event once per change', async () => {
+		await manager.open( cfg( 'a' ) );
+		const hook = vi.fn();
+		window.wp!.hooks!.addAction(
+			HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED,
+			'test/always-on-top',
+			hook,
+		);
+		const event = vi.fn();
+		document.addEventListener( 'os-window-always-on-top-changed', event );
+		const changed = vi.fn();
+		document.addEventListener( 'os-window-changed', changed );
+
+		expect( manager.setAlwaysOnTop( 'a', true ) ).toBe( true );
+		// Already on: no second notification.
+		expect( manager.setAlwaysOnTop( 'a', true ) ).toBe( true );
+		expect( manager.setAlwaysOnTop( 'missing', true ) ).toBe( false );
+
+		expect( hook ).toHaveBeenCalledTimes( 1 );
+		expect( hook ).toHaveBeenCalledWith( { windowId: 'a', alwaysOnTop: true } );
+		expect( event ).toHaveBeenCalledTimes( 1 );
+		// The session saver listens for this.
+		expect( changed ).toHaveBeenCalledTimes( 1 );
+		expect(
+			( changed.mock.calls[ 0 ][ 0 ] as CustomEvent ).detail.reason,
+		).toBe( 'always-on-top' );
+
+		document.removeEventListener( 'os-window-always-on-top-changed', event );
+		document.removeEventListener( 'os-window-changed', changed );
+	} );
+} );
+
+describe( 'keep on top — title-bar pin', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		_resetWindowControlRegistryForTests();
+		registerBuiltInControls();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
