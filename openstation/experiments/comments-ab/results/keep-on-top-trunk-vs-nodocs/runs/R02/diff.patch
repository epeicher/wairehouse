+/**
+ * "Keep on top".
+ *
+ * A window kept on top stacks above every window that isn't, whichever
+ * of them is focused or newly opened. Several can be kept on top at
+ * once and stack among themselves in focus order. Focus itself is not
+ * part of the deal: the stack top is still the focused window, it just
+ * may paint under a kept-on-top one.
+ *
+ * The tests pin the stacking against z-index — what the user sees —
+ * rather than `_stack`, which stays in focus order on purpose. They
+ * also cover the title-bar pin and the round trip through the session.
+ */
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { HOOKS } from '../../src/hooks';
+import type { NativeWindowRestoreState } from '../../src/native-windows';
+import {
+	_resetWindowControlRegistryForTests,
+} from '../../src/window-chrome/controls/registry';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { WindowManager } from '../../src/window-manager';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+import type { DesktopConfig, SessionWindow } from '../../src/types';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+/** Window ids in painted order — lowest z-index first. */
+function paintOrder( manager: WindowManager ): string[] {
+	return [ ...manager.getAll() ]
+		.sort(
+			( a, b ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
