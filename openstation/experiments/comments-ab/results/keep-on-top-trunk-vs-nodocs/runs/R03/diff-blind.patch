diff --git c/tests/vitest/window-always-on-top.test.ts w/tests/vitest/window-always-on-top.test.ts
new file mode 100644
index 00000000..4239866e
--- /dev/null
+++ w/tests/vitest/window-always-on-top.test.ts
@@ -0,0 +1,283 @@
+/**
+ * Keep on top.
+ *
+ * A kept-on-top window paints above every window that isn't, whichever
+ * one has focus and whatever opens next. Several can be kept on top at
+ * once and stack among themselves in focus order. Focus is untouched:
+ * the focused window may sit beneath a kept-on-top one.
+ *
+ * The flag rides the session snapshot, comes back through restore, and
+ * is toggled from the title-bar pin as well as from
+ * `windowManager.setAlwaysOnTop()`.
+ */
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import type { NativeWindowRestoreState } from '../../src/native-windows';
+import { WindowManager } from '../../src/window-manager';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import type { Window } from '../../src/window';
+import type { DesktopConfig } from '../../src/types';
+import { clearHooksStub, installHooksStub } from './helpers/hooks-stub';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', { value: 1600, configurable: true } );
+	Object.defineProperty( desktop, 'clientHeight', { value: 900, configurable: true } );
+	return desktop;
+}
+
+/** Window ids in painted order, lowest first. */
+function painted( manager: WindowManager ): string[] {
+	return manager
+		.getAll()
+		.slice()
+		.sort( ( a, b ) => Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ) )
+		.map( ( w ) => w.id );
+}
+
+function pin( win: Window ): HTMLElement {
+	return win.element.querySelector( '.os-window__btn--keep-on-top' ) as HTMLElement;
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		installHooksStub();
+		_resetWindowControlRegistryForTests();
+		registerBuiltInControls();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'stays above windows focused or opened after it', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+
+		expect( manager.setAlwaysOnTop( 'a', true ) ).toBe( true );
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( painted( manager ).at( -1 ) ).toBe( 'a' );
+		// Pinning is not focusing.
+		expect( b.isFocused() ).toBe( true );
+
+		manager.focus( b );
+		expect( painted( manager ).at( -1 ) ).toBe( 'a' );
+
+		const c = await manager.open( cfg( 'c' ) );
+		expect( c.isFocused() ).toBe( true );
+		expect( manager.getFocused() ).toBe( c );
+		expect( painted( manager ) ).toEqual( [ 'b', 'c', 'a' ] );
+	} );
+
+	test( 'several kept-on-top windows stack among themselves in focus order', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		const c = await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'c', true );
+
+		expect( painted( manager ) ).toEqual( [ 'b', 'a', 'c' ] );
+
+		manager.focus( a );
+		expect( painted( manager ) ).toEqual( [ 'b', 'c', 'a' ] );
+
+		manager.focus( 'b' );
+		expect( painted( manager ) ).toEqual( [ 'b', 'c', 'a' ] );
+
+		manager.focus( c );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a', 'c' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.setAlwaysOnTop( 'a', false );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( painted( manager ) ).toEqual( [ 'a', 'b' ] );
+		manager.focus( a );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'an unknown id is reported, not thrown', () => {
+		expect( manager.setAlwaysOnTop( 'nope', true ) ).toBe( false );
+	} );
+
+	test( 'a child of a kept-on-top window stays above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( painted( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'a change schedules a session save, a no-op does not', async () => {
+		await manager.open( cfg( 'a' ) );
+		const reasons: string[] = [];
+		const listener = ( e: Event ): void => {
+			reasons.push( ( e as CustomEvent< { reason: string } > ).detail.reason );
+		};
+		document.addEventListener( 'os-window-changed', listener );
+		try {
+			manager.setAlwaysOnTop( 'a', true );
+			manager.setAlwaysOnTop( 'a', true );
+		} finally {
+			document.removeEventListener( 'os-window-changed', listener );
+		}
+
+		expect( reasons ).toEqual( [ 'always-on-top' ] );
+	} );
+
+	test( 'the title-bar pin toggles it and shows the state', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		const button = pin( a );
+		expect( button ).not.toBeNull();
+		expect( button.getAttribute( 'aria-label' ) ).toBe( 'Keep on top' );
+		expect( button.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		button.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( painted( manager ).at( -1 ) ).toBe( 'a' );
+		expect( pin( a ).getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( pin( a ).hasAttribute( 'active' ) ).toBe( true );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe( true );
+
+		// A repaint of the cluster rebuilds the button; the state must
+		// survive it.
+		a.repaintWindowControls();
+		expect( pin( a ).getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+		pin( a ).dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( pin( a ).getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+		expect( a.element.classList.contains( 'os-window--always-on-top' ) ).toBe( false );
+	} );
+
+	test( 'the snapshot carries it only for kept-on-top windows', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const windows = manager.snapshot().windows;
+
+		expect( windows.find( ( w ) => w.id === 'a' )?.alwaysOnTop ).toBe( true );
+		expect( windows.find( ( w ) => w.id === 'b' ) ).not.toHaveProperty( 'alwaysOnTop' );
+	} );
+
+	test( 'survives a reload through the session', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		const session = manager.snapshot();
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+
+		const reloaded = new WindowManager( desktop );
+		const config = {
+			adminUrl: `${ ORIGIN }/wp-admin/`,
+			currentPage: `${ ORIGIN }/wp-admin/a.php`,
+			dockItems: [],
+			session,
+		} as unknown as DesktopConfig;
+		await restoreSession( reloaded, config, desktop );
+		manager = reloaded;
+
+		const a = reloaded.getById( 'a' )!;
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( pin( a ).getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		// `b` was focused when saved and is focused again — beneath `a`.
+		expect( reloaded.getFocused()?.id ).toBe( 'b' );
+		expect( painted( reloaded ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'session restore hands it to native window owners', async () => {
+		const config = {
+			adminUrl: `${ ORIGIN }/wp-admin/`,
+			currentPage: `${ ORIGIN }/wp-admin/`,
+			dockItems: [],
+			session: {
+				windows: [
+					{
+						...cfg( 'os-settings' ),
+						url: '#os-settings',
+						native: true,
+						state: 'normal',
+						x: 10,
+						y: 10,
+						width: 600,
+						height: 400,
+						alwaysOnTop: true,
+					},
+				],
+				desktops: [ { id: 'desktop-1', label: 'Desktop 1' } ],
+				activeDesktop: 'desktop-1',
+				focused: '',
+				updated: 1,
+			},
+		} as unknown as DesktopConfig;
+		const received: NativeWindowRestoreState[] = [];
+
+		await restoreSession( manager, config, desktop, ( id, _baseId, state = {} ) => {
+			received.push( state );
+			void manager.openNew( {
+				...cfg( id ),
+				native: true,
+				url: `#${ id }`,
+				render: () => undefined,
+				...state,
+			} );
+			return true;
+		} );
+
+		expect( received[ 0 ]?.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'os-settings' )?.alwaysOnTop ).toBe( true );
+	} );
+} );
