diff --git c/tests/vitest/window-always-on-top.test.ts w/tests/vitest/window-always-on-top.test.ts
new file mode 100644
index 00000000..e5914147
--- /dev/null
+++ w/tests/vitest/window-always-on-top.test.ts
@@ -0,0 +1,388 @@
+/**
+ * Keep on top.
+ *
+ * A window kept on top stacks above every window that isn't, however
+ * focus moves. Several can be kept on top at once and they stack in
+ * focus order among themselves. The flag is painted into z-index only
+ * — `_stack` stays in focus order, so the focused window is still the
+ * stack top that `getFocused()` reads.
+ *
+ * Also pinned here: the title-bar pin button, the change event the
+ * session saver listens for, and the round trip through a session
+ * snapshot and restore.
+ */
+import { afterEach, beforeEach, describe, expect, test } from 'vitest';
+import { restoreSession } from '../../src/boot/session';
+import { HOOKS } from '../../src/hooks';
+import type { NativeWindowRestoreState } from '../../src/native-windows';
+import type { DesktopConfig, Session, SessionWindow } from '../../src/types';
+import type { Window } from '../../src/window';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import { WindowManager } from '../../src/window-manager';
+import { clearHooksStub, installHooksStub, type FakeWpHooks } from './helpers/hooks-stub';
+
+const ORIGIN = window.location.origin;
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `${ ORIGIN }/wp-admin/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+function makeDesktop(): HTMLElement {
+	const desktop = document.createElement( 'div' );
+	desktop.id = 'os-area';
+	Object.defineProperty( desktop, 'getBoundingClientRect', {
+		value: () =>
+			( {
+				left: 0,
+				top: 0,
+				right: 1600,
+				bottom: 900,
+				width: 1600,
+				height: 900,
+				x: 0,
+				y: 0,
+				toJSON: () => ( {} ),
+			} ) as DOMRect,
+	} );
+	Object.defineProperty( desktop, 'clientWidth', {
+		value: 1600,
+		configurable: true,
+	} );
+	Object.defineProperty( desktop, 'clientHeight', {
+		value: 900,
+		configurable: true,
+	} );
+	return desktop;
+}
+
+/** Window ids in painted order, lowest z-index first. */
+function painted( manager: WindowManager ): string[] {
+	return [ ...manager.getAll() ]
+		.sort(
+			( a, b ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
+
+function pinButton( win: Window ): HTMLElement | null {
+	return win.element.querySelector< HTMLElement >(
+		'.os-window__controls .os-window__btn--pin',
+	);
+}
+
+describe( 'keep on top', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+	let hooks: FakeWpHooks;
+
+	beforeEach( () => {
+		hooks = installHooksStub();
+		_resetWindowControlRegistryForTests();
+		registerBuiltInControls();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'windows are not kept on top by default', async () => {
+		const win = await manager.open( cfg( 'a' ) );
+
+		expect( win.alwaysOnTop ).toBe( false );
+		expect( win.element.classList.contains( 'os-window--always-on-top' ) ).toBe( false );
+	} );
+
+	test( 'a kept-on-top window stays above a window focused after it', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+
+		expect( manager.setAlwaysOnTop( 'a', true ) ).toBe( true );
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.focus( b );
+
+		// Focus moved, the paint order didn't.
+		expect( manager.getFocused() ).toBe( b );
+		expect( b.isFocused() ).toBe( true );
+		expect( a.isFocused() ).toBe( false );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+	} );
+
+	test( 'a newly opened window opens under a kept-on-top one', async () => {
+		await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const c = await manager.open( cfg( 'c' ) );
+
+		expect( manager.getFocused() ).toBe( c );
+		expect( painted( manager ) ).toEqual( [ 'c', 'a' ] );
+	} );
+
+	test( 'several kept-on-top windows stack in focus order among themselves', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		expect( painted( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+
+		manager.focus( a );
+		expect( painted( manager ) ).toEqual( [ 'c', 'b', 'a' ] );
+
+		manager.focus( b );
+		expect( painted( manager ) ).toEqual( [ 'c', 'a', 'b' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		await manager.open( cfg( 'a' ) );
+		const b = await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		manager.setAlwaysOnTop( 'a', false );
+
+		// `b` is the focused window, so it is back in front.
+		expect( manager.getFocused() ).toBe( b );
+		expect( painted( manager ) ).toEqual( [ 'a', 'b' ] );
+	} );
+
+	test( 'unknown ids are a no-op that reports false', () => {
+		expect( manager.setAlwaysOnTop( 'nope', true ) ).toBe( false );
+	} );
+
+	test( 'raise() does not lift a window above a kept-on-top one', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'c' ) );
+		await manager.open( cfg( 'd' ) );
+		manager.setAlwaysOnTop( 'c', true );
+		manager.focus( 'b' );
+
+		manager.raise( 'a' );
+
+		// Raised to just under the focused window — and still under
+		// the window kept on top.
+		expect( painted( manager ) ).toEqual( [ 'd', 'a', 'b', 'c' ] );
+	} );
+
+	test( 'a child of a kept-on-top owner stays above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		manager.focus( 'other' );
+
+		expect( painted( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'toggling fires the change event and the action, once per real change', async () => {
+		await manager.open( cfg( 'a' ) );
+		const changes: Array< { windowId: string; reason: string } > = [];
+		const onChange = ( e: Event ): void => {
+			changes.push( ( e as CustomEvent ).detail );
+		};
+		document.addEventListener( 'os-window-changed', onChange );
+		const actions: unknown[] = [];
+		hooks.addAction(
+			HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED,
+			'test',
+			( payload: unknown ) => actions.push( payload ),
+		);
+
+		try {
+			manager.setAlwaysOnTop( 'a', true );
+			manager.setAlwaysOnTop( 'a', true );
+			manager.setAlwaysOnTop( 'a', false );
+		} finally {
+			document.removeEventListener( 'os-window-changed', onChange );
+		}
+
+		expect( changes.map( ( c ) => c.windowId ) ).toEqual( [ 'a', 'a' ] );
+		expect( actions ).toEqual( [
+			{ windowId: 'a', alwaysOnTop: true },
+			{ windowId: 'a', alwaysOnTop: false },
+		] );
+	} );
+
+	test( 'the pin button toggles keep on top and reflects it', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		const btn = pinButton( a );
+		expect( btn ).not.toBeNull();
+		expect( btn!.getAttribute( 'aria-label' ) ).toBe( 'Keep on top' );
+		expect( btn!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		btn!.dispatchEvent( new CustomEvent( 'os-button-activate', { bubbles: true } ) );
+
+		expect( a.alwaysOnTop ).toBe( true );
+		expect( btn!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( btn!.hasAttribute( 'active' ) ).toBe( true );
+		expect( painted( manager ) ).toEqual( [ 'b', 'a' ] );
+
+		btn!.dispatchEvent( new CustomEvent( 'os-button-activate', { bubbles: true } ) );
+
+		expect( a.alwaysOnTop ).toBe( false );
+		expect( btn!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+		expect( btn!.hasAttribute( 'active' ) ).toBe( false );
+	} );
+
+	test( 'the pin button keeps its state across a controls repaint', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		a.repaintWindowControls();
+
+		expect( pinButton( a )!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+	} );
+
+	test( 'the snapshot carries the flag only for windows kept on top', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		const byId = Object.fromEntries(
+			manager.snapshot().windows.map( ( w ) => [ w.id, w ] ),
+		);
+
+		expect( byId.a.alwaysOnTop ).toBe( true );
+		expect( 'alwaysOnTop' in byId.b ).toBe( false );
+	} );
+
+	test( 'a window opened with alwaysOnTop starts kept on top', async () => {
+		await manager.open( cfg( 'a' ) );
+		const b = await manager.openNew( cfg( 'b', { alwaysOnTop: true } ) );
+		await manager.open( cfg( 'c' ) );
+
+		expect( b.alwaysOnTop ).toBe( true );
+		expect( pinButton( b )!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( painted( manager ) ).toEqual( [ 'a', 'c', 'b' ] );
+	} );
+} );
+
+describe( 'keep on top — session restore', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	function sessionWindow( patch: Partial< SessionWindow > = {} ): SessionWindow {
+		return {
+			id: 'edit-php',
+			baseId: 'edit-php',
+			desktopId: 'desktop-1',
+			url: `${ ORIGIN }/wp-admin/edit.php`,
+			title: 'Posts',
+			icon: 'dashicons-admin-post',
+			state: 'normal',
+			x: 100,
+			y: 80,
+			width: 900,
+			height: 600,
+			...patch,
+		};
+	}
+
+	function desktopConfig( windows: SessionWindow[], focused = '' ): DesktopConfig {
+		const session: Session = {
+			windows,
+			desktops: [ { id: 'desktop-1', label: 'Desktop 1' } ],
+			activeDesktop: 'desktop-1',
+			focused,
+			updated: 123,
+		};
+		return {
+			adminUrl: `${ ORIGIN }/wp-admin/`,
+			currentPage: `${ ORIGIN }/wp-admin/edit.php`,
+			currentTitle: 'Posts',
+			currentIcon: 'dashicons-admin-post',
+			dockItems: [],
+			session,
+		} as unknown as DesktopConfig;
+	}
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	test( 'a window saved kept on top comes back kept on top', async () => {
+		const config = desktopConfig(
+			[
+				sessionWindow( { id: 'pinned', baseId: 'pinned', alwaysOnTop: true } ),
+				sessionWindow( {
+					id: 'plain',
+					baseId: 'plain',
+					url: `${ ORIGIN }/wp-admin/upload.php`,
+				} ),
+			],
+			'plain',
+		);
+
+		await restoreSession( manager, config, desktop );
+
+		expect( manager.getById( 'pinned' )!.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'plain' )!.alwaysOnTop ).toBe( false );
+		expect( manager.getFocused()!.id ).toBe( 'plain' );
+		expect( painted( manager ) ).toEqual( [ 'plain', 'pinned' ] );
+	} );
+
+	test( 'a native window saved kept on top comes back kept on top', async () => {
+		const opener = (
+			id: string,
+			baseId = id,
+			state: NativeWindowRestoreState = {},
+		): boolean => {
+			void manager.openNew( {
+				id,
+				baseId,
+				native: true,
+				url: `#${ baseId }`,
+				title: 'OS Settings',
+				icon: 'dashicons-desktop',
+				render: () => {},
+				...state,
+			} );
+			return true;
+		};
+		const config = desktopConfig( [
+			sessionWindow( {
+				id: 'desktop-mode-os-settings',
+				baseId: 'desktop-mode-os-settings',
+				native: true,
+				url: '#os-settings',
+				alwaysOnTop: true,
+			} ),
+		] );
+
+		await restoreSession( manager, config, desktop, opener );
+
+		expect( manager.getById( 'desktop-mode-os-settings' )!.alwaysOnTop ).toBe( true );
+	} );
+} );
