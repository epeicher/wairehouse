+		expect( a.alwaysOnTop ).toBe( false );
+		expect( btn!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+		expect( btn!.hasAttribute( 'active' ) ).toBe( false );
+	} );
+
+	test( 'the pin button keeps its state across a controls repaint', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'a', true );
+
+		a.repaintWindowControls();
+
+		expect( pinButton( a )!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+	} );
+
+	test( 'the snapshot carries the flag only for windows kept on top', async () => {
+		await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
