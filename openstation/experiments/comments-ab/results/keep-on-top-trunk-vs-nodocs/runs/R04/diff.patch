+		expect( btn!.getAttribute( 'aria-label' ) ).toBe( 'Keep on top' );
+		expect( btn!.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		btn!.dispatchEvent( new CustomEvent( 'os-button-activate', { bubbles: true } ) );
