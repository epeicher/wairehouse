+		await manager.open( cfg( 'c' ) );
+
+		expect( b.alwaysOnTop ).toBe( true );
+		expect( pinButton( b )!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( painted( manager ) ).toEqual( [ 'a', 'c', 'b' ] );
+	} );
+} );
+
+describe( 'keep on top — session restore', () => {
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	function sessionWindow( patch: Partial< SessionWindow > = {} ): SessionWindow {
+		return {
+			id: 'edit-php',
+			baseId: 'edit-php',
+			desktopId: 'desktop-1',
+			url: `${ ORIGIN }/wp-admin/edit.php`,
+			title: 'Posts',
+			icon: 'dashicons-admin-post',
+			state: 'normal',
+			x: 100,
+			y: 80,
+			width: 900,
+			height: 600,
+			...patch,
+		};
+	}
+
+	function desktopConfig( windows: SessionWindow[], focused = '' ): DesktopConfig {
+		const session: Session = {
+			windows,
+			desktops: [ { id: 'desktop-1', label: 'Desktop 1' } ],
+			activeDesktop: 'desktop-1',
+			focused,
+			updated: 123,
+		};
+		return {
+			adminUrl: `${ ORIGIN }/wp-admin/`,
+			currentPage: `${ ORIGIN }/wp-admin/edit.php`,
+			currentTitle: 'Posts',
+			currentIcon: 'dashicons-admin-post',
+			dockItems: [],
+			session,
+		} as unknown as DesktopConfig;
+	}
+
+	beforeEach( () => {
+		installHooksStub();
+		desktop = makeDesktop();
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		clearHooksStub();
+	} );
+
+	test( 'a window saved kept on top comes back kept on top', async () => {
+		const config = desktopConfig(
+			[
+				sessionWindow( { id: 'pinned', baseId: 'pinned', alwaysOnTop: true } ),
+				sessionWindow( {
+					id: 'plain',
+					baseId: 'plain',
+					url: `${ ORIGIN }/wp-admin/upload.php`,
+				} ),
+			],
+			'plain',
+		);
+
+		await restoreSession( manager, config, desktop );
+
+		expect( manager.getById( 'pinned' )!.alwaysOnTop ).toBe( true );
+		expect( manager.getById( 'plain' )!.alwaysOnTop ).toBe( false );
+		expect( manager.getFocused()!.id ).toBe( 'plain' );
+		expect( painted( manager ) ).toEqual( [ 'plain', 'pinned' ] );
+	} );
+
+	test( 'a native window saved kept on top comes back kept on top', async () => {
+		const opener = (
+			id: string,
+			baseId = id,
+			state: NativeWindowRestoreState = {},
+		): boolean => {
+			void manager.openNew( {
+				id,
+				baseId,
+				native: true,
+				url: `#${ baseId }`,
+				title: 'OS Settings',
+				icon: 'dashicons-desktop',
+				render: () => {},
+				...state,
+			} );
+			return true;
+		};
+		const config = desktopConfig( [
+			sessionWindow( {
+				id: 'desktop-mode-os-settings',
+				baseId: 'desktop-mode-os-settings',
+				native: true,
+				url: '#os-settings',
+				alwaysOnTop: true,
+			} ),
+		] );
+
+		await restoreSession( manager, config, desktop, opener );
+
+		expect( manager.getById( 'desktop-mode-os-settings' )!.alwaysOnTop ).toBe( true );
+	} );
+} );
