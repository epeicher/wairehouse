+		// Focus still moves — only the paint order is held.
+		expect( opened.isFocused() ).toBe( true );
+		expect( pinned.isFocused() ).toBe( false );
+		expect( paintOrder( manager ).at( -1 ) ).toBe( 'pinned' );
+
+		manager.setAlwaysOnTop( 'pinned', false );
+
+		expect( pinned.alwaysOnTop ).toBe( false );
+		expect( paintOrder( manager ) ).toEqual( zOrder( manager ) );
+		expect( paintOrder( manager ).at( -1 ) ).toBe( 'opened' );
+	} );
+
+	test( 'several windows kept on top stack in focus order among themselves', async () => {
+		const a = await manager.open( cfg( 'a' ) );
+		await manager.open( cfg( 'b' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'a', true );
+		manager.setAlwaysOnTop( 'b', true );
+
+		manager.focus( a );
+		manager.focus( 'plain' );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'plain', 'b', 'a' ] );
+	} );
+
+	test( 'the pin control toggles it', async () => {
+		registerBuiltInControls();
+		try {
+			const win = await manager.open( cfg( 'win' ) );
+			const pin = () =>
+				win.element.querySelector( '.os-window__btn--keep-on-top' );
+			expect( pin() ).not.toBeNull();
+
+			pin()!.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+			expect( win.alwaysOnTop ).toBe( true );
+			expect( pin()!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+			// The painter rebuilds the button without knowing the state,
+			// so a repaint must not reset it to "off".
+			win.repaintWindowControls();
+			expect( pin()!.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+			pin()!.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+			expect( win.alwaysOnTop ).toBe( false );
+		} finally {
+			_resetWindowControlRegistryForTests();
+		}
+	} );
+
+	test( 'a child of a window kept on top still paints above its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( paintOrder( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+} );
