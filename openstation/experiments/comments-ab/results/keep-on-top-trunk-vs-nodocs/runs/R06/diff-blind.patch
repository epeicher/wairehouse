diff --git c/src/window-manager/keep-on-top.ts w/src/window-manager/keep-on-top.ts
new file mode 100644
index 00000000..53e1cf1f
--- /dev/null
+++ w/src/window-manager/keep-on-top.ts
@@ -0,0 +1,94 @@
+/**
+ * "Keep on top" — the window layer above the rest.
+ *
+ * `_stack` stays what it has always been: focus order, last = focused.
+ * Keeping a window on top does not move it there, because the stack
+ * top is what `getFocused()` reads, and a window kept on top is
+ * routinely NOT the focused one — the user pinned a reference panel
+ * and went back to work underneath it. So the layer is applied when
+ * z-indices are written instead: every window that isn't kept on top
+ * first, in stack order, then every window that is, in stack order.
+ * Among themselves the kept windows still stack by focus, and the
+ * z-indices stay one contiguous run above the base, so nothing else
+ * in the shell's z-scale has to move.
+ *
+ * Fullscreen still wins: its `z-index` is an `!important` token far
+ * above this run.
+ */
+
+import { HOOKS, doAction } from '../hooks';
+import type { Window } from '../window';
+import type { WindowManager } from './index';
+
+/**
+ * Whether `win` belongs in the top layer: it is kept on top, or one
+ * of its owners is. A child of a kept window has to come along — its
+ * owner can never sit above it, and an owner in the top layer would.
+ *
+ * @param mgr Window manager.
+ * @param win Window to place.
+ */
+function inTopLayer( mgr: WindowManager, win: Window ): boolean {
+	// `seen` guards against a cycle in plugin-declared ownership, as
+	// `blockingChildOf()` does.
+	const seen = new Set< Window >();
+	let current: Window | undefined = win;
+	while ( current && ! seen.has( current ) ) {
+		if ( current.alwaysOnTop ) {
+			return true;
+		}
+		seen.add( current );
+		current = mgr.ownerOf( current );
+	}
+	return false;
+}
+
+/**
+ * Write every window's z-index from the stack, top layer last.
+ *
+ * @param mgr  Window manager.
+ * @param base z-index of the bottom-most window.
+ */
+export function applyStackZIndices( mgr: WindowManager, base: number ): void {
+	const top: Window[] = [];
+	let z = base;
+	for ( const w of mgr._stack ) {
+		if ( inTopLayer( mgr, w ) ) {
+			top.push( w );
+		} else {
+			w.setZIndex( z++ );
+		}
+	}
+	for ( const w of top ) {
+		w.setZIndex( z++ );
+	}
+}
+
+/**
+ * Keep a window on top, or stop. See `WindowManager.setAlwaysOnTop`.
+ *
+ * @param mgr      Window manager.
+ * @param windowId Window to change.
+ * @param enabled  Whether to keep it on top.
+ * @param base     z-index of the bottom-most window.
+ */
+export function setAlwaysOnTop(
+	mgr: WindowManager,
+	windowId: string,
+	enabled: boolean,
+	base: number,
+): void {
+	const win = mgr.getById( windowId );
+	const on = !! enabled;
+	if ( ! win || win.alwaysOnTop === on ) {
+		return;
+	}
+	win._applyAlwaysOnTop( on );
+	applyStackZIndices( mgr, base );
+
+	const detail = { windowId: win.id, alwaysOnTop: on };
+	document.dispatchEvent(
+		new CustomEvent( 'os-window-always-on-top-changed', { detail } ),
+	);
+	doAction( HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED, detail );
+}
