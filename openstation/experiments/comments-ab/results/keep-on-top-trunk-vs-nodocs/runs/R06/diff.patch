diff --git c/tests/vitest/window-keep-on-top.test.ts w/tests/vitest/window-keep-on-top.test.ts
new file mode 100644
index 00000000..73f4509c
--- /dev/null
+++ w/tests/vitest/window-keep-on-top.test.ts
@@ -0,0 +1,185 @@
+/**
+ * "Keep on top".
+ *
+ * The stack stays focus order — its top is what `getFocused()` reads —
+ * and the kept layer is applied when z-indices are written. So the
+ * tests read the painted z-index, not the stack, and check focus
+ * separately: a window kept on top paints above the focused one
+ * without taking its focus.
+ */
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { WindowManager } from '../../src/window-manager';
+import { HOOKS } from '../../src/hooks';
+import { registerBuiltInControls } from '../../src/window-chrome/controls/built-ins';
+import { _resetWindowControlRegistryForTests } from '../../src/window-chrome/controls/registry';
+import type { Window } from '../../src/window';
+import {
+	clearHooksStub,
+	installHooksStub,
+	recordActions,
+	type FakeWpHooks,
+} from './helpers/hooks-stub';
+
+function cfg( id: string, extra: Record< string, unknown > = {} ) {
+	return {
+		id,
+		url: `http://example.test/${ id }.php`,
+		title: id,
+		icon: 'dashicons-admin-generic',
+		...extra,
+	};
+}
+
+/** Window ids by painted z-index, lowest first. */
+function painted( manager: WindowManager ): string[] {
+	return [ ...manager.getAll() ]
+		.sort(
+			( a: Window, b: Window ) =>
+				Number( a.element.style.zIndex ) - Number( b.element.style.zIndex ),
+		)
+		.map( ( w ) => w.id );
+}
+
+describe( 'keep on top', () => {
+	let hooks: FakeWpHooks;
+	let desktop: HTMLElement;
+	let manager: WindowManager;
+
+	beforeEach( () => {
+		hooks = installHooksStub();
+		registerBuiltInControls();
+		desktop = document.createElement( 'div' );
+		desktop.id = 'os-area';
+		Object.defineProperty( desktop, 'clientWidth', { value: 1600, configurable: true } );
+		Object.defineProperty( desktop, 'clientHeight', { value: 900, configurable: true } );
+		document.body.appendChild( desktop );
+		manager = new WindowManager( desktop );
+	} );
+
+	afterEach( () => {
+		for ( const w of manager.getAll() ) {
+			w.destroy();
+		}
+		desktop.remove();
+		_resetWindowControlRegistryForTests();
+		clearHooksStub();
+	} );
+
+	test( 'stays above windows focused or opened after it, without taking focus', async () => {
+		await manager.open( cfg( 'pinned' ) );
+		const a = await manager.open( cfg( 'a' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+
+		manager.focus( a );
+		const b = await manager.open( cfg( 'b' ) );
+
+		expect( painted( manager ).at( -1 ) ).toBe( 'pinned' );
+		expect( b.isFocused() ).toBe( true );
+		expect( manager.getFocused() ).toBe( b );
+		expect( manager.getById( 'pinned' )!.alwaysOnTop ).toBe( true );
+	} );
+
+	test( 'several kept windows stack among themselves in focus order', async () => {
+		await manager.open( cfg( 'one' ) );
+		await manager.open( cfg( 'two' ) );
+		await manager.open( cfg( 'plain' ) );
+		manager.setAlwaysOnTop( 'one', true );
+		manager.setAlwaysOnTop( 'two', true );
+
+		manager.focus( 'one' );
+		expect( painted( manager ) ).toEqual( [ 'plain', 'two', 'one' ] );
+
+		manager.focus( 'plain' );
+		expect( painted( manager ) ).toEqual( [ 'plain', 'two', 'one' ] );
+
+		manager.focus( 'two' );
+		expect( painted( manager ) ).toEqual( [ 'plain', 'one', 'two' ] );
+	} );
+
+	test( 'turning it off restores normal stacking', async () => {
+		await manager.open( cfg( 'pinned' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'pinned', true );
+		expect( painted( manager ).at( -1 ) ).toBe( 'pinned' );
+
+		manager.setAlwaysOnTop( 'pinned', false );
+
+		expect( painted( manager ).at( -1 ) ).toBe( 'other' );
+		expect( manager.getById( 'pinned' )!.alwaysOnTop ).toBe( false );
+	} );
+
+	test( 'a child of a kept window is never buried under its owner', async () => {
+		await manager.open( cfg( 'owner' ) );
+		await manager.openChild( 'owner', cfg( 'child' ) );
+		await manager.open( cfg( 'other' ) );
+		manager.setAlwaysOnTop( 'owner', true );
+
+		expect( painted( manager ) ).toEqual( [ 'other', 'owner', 'child' ] );
+	} );
+
+	test( 'announces a change once, and not at all when nothing changed', async () => {
+		await manager.open( cfg( 'w' ) );
+		const actions = recordActions( hooks, [ HOOKS.WINDOW_ALWAYS_ON_TOP_CHANGED ] );
+		const listener = vi.fn();
+		document.addEventListener( 'os-window-always-on-top-changed', listener );
+
+		manager.setAlwaysOnTop( 'w', true );
+		manager.setAlwaysOnTop( 'w', true );
+		manager.setAlwaysOnTop( 'missing', true );
+
+		document.removeEventListener( 'os-window-always-on-top-changed', listener );
+		expect( listener ).toHaveBeenCalledTimes( 1 );
+		expect( listener.mock.calls[ 0 ][ 0 ].detail ).toEqual( {
+			windowId: 'w',
+			alwaysOnTop: true,
+		} );
+		expect( actions ).toHaveLength( 1 );
+	} );
+
+	test( 'the title-bar pin toggles it and reflects the state', async () => {
+		const win = await manager.open( cfg( 'w' ) );
+		const pin = win.element.querySelector< HTMLElement >(
+			'.os-window__controls .os-window__btn--keep-on-top',
+		)!;
+		expect( pin.getAttribute( 'aria-pressed' ) ).toBe( 'false' );
+
+		pin.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+		expect( win.alwaysOnTop ).toBe( true );
+		expect( pin.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+		expect( pin.hasAttribute( 'active' ) ).toBe( true );
+
+		// A controls repaint builds the button fresh; it must come back
+		// pressed.
+		win.repaintWindowControls();
+		const repainted = win.element.querySelector< HTMLElement >(
+			'.os-window__btn--keep-on-top',
+		)!;
+		expect( repainted.getAttribute( 'aria-pressed' ) ).toBe( 'true' );
+
+		repainted.dispatchEvent( new CustomEvent( 'os-button-activate' ) );
+		expect( win.alwaysOnTop ).toBe( false );
+	} );
+
+	test( 'survives a session round-trip', async () => {
