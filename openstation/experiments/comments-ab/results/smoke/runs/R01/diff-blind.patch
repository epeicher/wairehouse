@@ -108,0 +109,38 @@ describe( 'WindowManager — Arrange (tile + snap)', async () => {
+	test( 'tile() puts three windows in thirds on one row', async () => {
+		const wins = [
+			await manager.open( openConfig( 'a' ) ),
+			await manager.open( openConfig( 'b' ) ),
+			await manager.open( openConfig( 'c' ) ),
+		];
+
+		manager.tile();
+
+		// 1568 wide, two 12px gaps: 514 each, one row 868 tall.
+		expect(
+			wins.map( ( w ) => [ w.element.style.left, w.element.style.top, w.element.style.width, w.element.style.height ] ),
+		).toEqual( [
+			[ '16px', '16px', '514px', '868px' ],
+			[ '542px', '16px', '514px', '868px' ],
+			[ '1068px', '16px', '514px', '868px' ],
+		] );
+	} );
+
+	test( 'tile() lets a short last row fill its width', async () => {
+		const wins = [];
+		for ( const id of [ 'a', 'b', 'c', 'd', 'e' ] ) {
+			wins.push( await manager.open( openConfig( id ) ) );
+		}
+
+		manager.tile();
+
+		// 3×2: three thirds on top, the last two in halves below.
+		expect( wins.map( ( w ) => w.element.style.width ) ).toEqual( [
+			'514px',
+			'514px',
+			'514px',
+			'778px',
+			'778px',
+		] );
+		expect( wins[ 4 ].element.style.left ).toBe( '806px' );
